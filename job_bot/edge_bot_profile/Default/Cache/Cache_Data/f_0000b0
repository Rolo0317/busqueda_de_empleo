ovider.searchByTerm({ term: termValue, t, ...providerParams });\n      setOptions(landings);\n    };\n\n    handleFilterData(isEmpty(debounceTerm) ? \"all\" : debounceTerm);\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [debounceTerm]);\n\n  return {\n    term,\n    setTerm,\n    options,\n    setOptions,\n    t\n  };\n};\n\nexport default useSearchBar;\n","import { fillUrlUtms } from \"@shared/utils/url/fillUrlUtms.util\";\nimport { useSearchParams } from \"next/navigation\";\nimport { useCallback } from \"react\";\ntype TUseRedirect = () => {\n  redirect: (url: string) => () => void;\n};\n\nexport const useRedirect: TUseRedirect = () => {\n  const searchParams = useSearchParams();\n  const redirect = useCallback(\n    (url: string) => () => {\n      const urlWithUtms = fillUrlUtms(url, searchParams);\n      window.location.href = urlWithUtms;\n    },\n    [searchParams]\n  );\n  return { redirect };\n};\n","// extracted by mini-css-extract-plugin\nmodule.exports = {\"mega-menu__select-country\":\"megaMenu_mega-menu__select-country__WWC7k\"};\nmodule.exports.__checksum = \"be61ef245d3d\"\n","import {\n  TFilterEqualValue,\n  TFilterRangeValue,\n  TGlobalFilterSettings,\n  TRevertFiltersSearch\n} from \"@shared/types/filter.core\";\nimport { isEmpty, pick } from \"lodash\";\n\nconst isRangeValue = (v: TFilterRangeValue | TFilterEqualValue): v is TFilterRangeValue => {\n  return v != null && typeof v === \"object\" && \"from\" in v && \"to\" in v;\n};\n\nexport const revertFilterSettings = (filters: TGlobalFilterSettings): TRevertFiltersSearch => {\n  let data: TRevertFiltersSearch = {};\n  for (const { values, field, label } of filters.filters) {\n    if (isEmpty(values)) continue;\n    values.forEach((value) => {\n      data = {\n        ...data,\n        [value.slugifyLabel]: {\n          field,\n          label,\n          value: isRangeValue(value) ? pick(value, [\"to\", \"from\", \"id\"]) : value.id\n        }\n      };\n    });\n  }\n  return data;\n};\n","import { TGlobalFilterSettings } from \"@shared/types/filter.core\";\nimport { revertFilterSettings } from \"../filters/revertFilterSettings.util\";\n\nexport const generateBreadCrumbs = (breadCrumbText: string) => {\n  return breadCrumbText.split(\"/\").filter((link) => link.trim() !== \"\");\n};\n\nconst cleanLocationPrefix = (text: string, removePrefix: boolean = false): string =>\n  removePrefix && text.startsWith(\"loc \") ? text.substring(4) : text;\n\nconst generateBreadCrumbsFiltersBase = (\n  breadCrumbText: string,\n  filterSettings: TGlobalFilterSettings,\n  removeLocPrefix: boolean = false\n): string[] => {\n  if (!filterSettings) return [];\n  const reverseFilters = revertFilterSettings(filterSettings);\n  const filters = breadCrumbText.split(\"/\");\n  const labels: string[] = [];\n  filters.forEach((segment) => {\n    if (segment?.trim()) {\n      labels.push(cleanLocationPrefix(segment, removeLocPrefix));\n    }\n  });\n\n  if (labels.length === 0) {\n    filters.slice(3).forEach((substring) => {\n      if (!substring?.trim()) return;\n\n      const cleanedSubstring = cleanLocationPrefix(substring, removeLocPrefix);\n      const temp: string[] = [];\n\n      cleanedSubstring.split(\" \").forEach((single) => {\n        temp.push(single);\n        const term = temp.join(\"-\");\n        const filter = reverseFilters[term];\n\n        if (filter?.value && typeof filter.value === \"string\") {\n          labels.push(filter.value.toLowerCase());\n          temp.length = 0;\n        }\n      });\n    });\n  }\n\n  return labels.slice(0, 6);\n};\n\nexport const generateBreadCrumbsFilters = (breadCrumbText: string, filterSettings: TGlobalFilterSettings) =>\n  generateBreadCrumbsFiltersBase(breadCrumbText, filterSettings);\n\nexport const generateBreadCrumbsFiltersDisplay = (breadCrumbText: string, filterSettings: TGlobalFilterSettings) =>\n  generateBreadCrumbsFiltersBase(breadCrumbText, filterSettings, true);\n\nexport const generateBreadCrumbUrl = (breadCrumbList: string[], baseUrl: string, queryString = \"\") => {\n  return breadCrumbList.map((_, index) => {\n    const pathSegments = breadCrumbList.slice(0, index + 1);\n    const url = `${baseUrl}${pathSegments.join(\"/\")}`.replace(/\\s+/g, \"-\");\n    return queryString ? `${url}?${queryString}` : url;\n  });\n};\n\nexport const formatBreadcrumbText = (breadCrumbFromServer: string[]): string => {\n  return `/${breadCrumbFromServer.join(\"/\")}`;\n};\n","\"use client\";\nimport { useContext, useMemo } from \"react\";\nimport { fullBasePath } from \"@shared/constants/environment.constant\";\nimport { magnetoHomeNext } from \"@shared/constants/companyLinks.constant\";\nimport { JobsContext } from \"@shared/context/jobs.context\";\nimport {\n  generateBreadCrumbs,\n  generateBreadCrumbsFilters,\n  generateBreadCrumbsFiltersDisplay,\n  generateBreadCrumbUrl\n} from \"@shared/utils/strings/generateBreadCrumbs.util\";\nimport { useParams, usePathname, useSearchParams } from \"next/navigation\";\nimport { TFunction } from \"@shared/types/locales\";\n\ntype TProps = {\n  t: TFunction;\n};\n\nconst useBreadcrumb = ({ t }: TProps) => {\n  const { selectedJob, filterSettings } = useContext(JobsContext);\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const query = useParams();\n\n  const urlBreadcrumText = useMemo(() => {\n    const basePath = pathname.replace(/-/gi, \" \");\n    return basePath;\n  }, [pathname]);\n  const homeUrl = magnetoHomeNext;\n  const isCompanySearchRoute =\n    Boolean(query.companySlug) &&\n    urlBreadcrumText.includes(t(\"routes.searchByCompany\", { companySlug: String(query.companySlug) }));\n  const isSearchRoute = urlBreadcrumText.includes(t(\"routes.search\")) || isCompanySearchRoute;\n\n  const breadCrumbsList = isSearchRoute\n    ? generateBreadCrumbsFilters(urlBreadcrumText, filterSettings)\n    : generateBreadCrumbs(urlBreadcrumText);\n\n  const breadCrumbsListDisplay = isSearchRoute\n   