s } from \"@shared/utils/url/fillUrlUtms.util\";\nimport { linkToShare } from \"@utils/jobOffers/linkToShare.util\";\nimport { JobsContext } from \"@shared/context/jobs.context\";\nimport styles from \"./jobOfferDetailActionsDown.module.scss\";\n\ntype Props = {\n  hideApplyButton?: boolean;\n};\n\nconst JobOfferDetailActionsDown = ({ hideApplyButton = false }: Props) => {\n  const { selectedJob } = use(JobsContext);\n  const t = useTranslations();\n  const params = useParams();\n  const query = useSearchParams();\n  const detailUrl = useMemo(() => {\n    const url =\n      params.companySlug && selectedJob?.confidential == false\n        ? `${t(\"routes.jobsByCompany\", { companySlug: params.companySlug as string })}/${selectedJob?.jobSlug}`\n        : t(\"routes.jobsView\", { jobSlug: selectedJob?.jobSlug ?? \"\" });\n\n    return fillUrlUtms(linkToShare(url), query);\n  }, [params, selectedJob?.jobSlug, selectedJob?.confidential, t, query]);\n\n  const showCopiedMessage = useCallback((messageText: string) => {\n    message.success(messageText);\n  }, []);\n\n  const showError = useCallback((messageText: string) => {\n    message.error(messageText);\n  }, []);\n  const handleCopy = useCallback(() => {\n    if (!detailUrl) {\n      showError(t(\"jobOffers.offer.copyFailed\"));\n      return;\n    }\n\n    navigator.clipboard\n      .writeText(detailUrl)\n      .then(() => showCopiedMessage(t(\"jobOffers.offer.copiedLink\")))\n      .catch(() => showError(t(\"jobOffers.offer.copyFailed\")));\n  }, [detailUrl, showCopiedMessage, showError, t]);\n\n  if (selectedJob == null) return null;\n\n  const shareText = t(\"jobOffers.offer.checkOutThisJobOffer\");\n  const encodedUrl = encodeURIComponent(detailUrl);\n  const encodedShareText = encodeURIComponent(shareText);\n\n  return (\n    <section className={classNames(styles[\"job-detail-actions-down\"])}>\n      {!hideApplyButton && <RenderApplyButton />}\n      <section className={classNames(styles[\"job-detail-actions-d