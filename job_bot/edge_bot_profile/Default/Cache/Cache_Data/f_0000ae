Names from \"classnames/bind\";\nimport { Typography } from \"magneto365.ui\";\nimport { useTranslations } from \"next-intl\";\nimport { useSearchParams } from \"next/navigation\";\nimport { JobDetails } from \"magneto365.ui/Domain/Jobs\";\nimport { JobsContext } from \"@shared/context/jobs.context\";\nimport { fillUrlUtms } from \"@shared/utils/url/fillUrlUtms.util\";\nimport styles from \"./JobOfferDetailSeeCompany.module.scss\";\n\nconst cx = classNames.bind(styles);\n\nconst JobOfferDetailSeeCompany = () => {\n  const t = useTranslations();\n  const query = useSearchParams();\n  const { selectedJob } = use(JobsContext);\n  if (!selectedJob) return null;\n  const { confidential, companySlug, companyName } = selectedJob;\n  if (confidential || !companySlug) return null;\n  return (\n    <Typography.Link\n      className={cx(\"see-company\")}\n      href={fillUrlUtms(t<string>(\"routes.landing\", { companySlug }), query)}\n    >\n      <JobDetails.Subtitle icon=\"building\">\n        {t(\"jobOffers.actions.landing\")}: {companyName}\n      </JobDetails.Subtitle>\n    </Typography.Link>\n  );\n};\n\nexport default JobOfferDetailSeeCompany;\n","import { use } from \"react\";\nimport classNames from \"classnames/bind\";\nimport styles from \"./JobOfferDetailContent.module.scss\";\nimport { JobsContext } from \"@shared/context/jobs.context\";\n\nconst cx = classNames.bind(styles);\n\nconst JobOfferDetailContent = () => {\n  const { selectedJob } = use(JobsContext);\n\n  if (selectedJob == null) return null;\n\n  if (selectedJob.description == null) return null;\n\n  return <div className={cx(\"content\")} dangerouslySetInnerHTML={{ __html: selectedJob.description }} />;\n};\n\nexport default JobOfferDetailContent;\n","import { use, useMemo } from \"react\";\nimport { useTranslations } from \"next-intl\";\nimport { Typography } from \"magneto365.ui\";\nimport { JobDetails } from \"magneto365.ui/Domain/Jobs\";\nimport { JobsContext } from \"@shared/context/jobs.context\"