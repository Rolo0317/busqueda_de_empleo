  question,\n      //       href: `${basePath}/preguntas-frecuentes/${slug}/${questionSlug}`\n      //     })) ?? []\n      // }\n    },\n    mobileJobDetailsDrawerProps: { ...mobileDetailProps, canApply },\n    jobDetailAction: jobDetailViewAction\n  };\n};\n\nexport default useMagnetoJobDetail;\n","export enum altDynamicText {\n  workAt = \"Trabajo en\"\n}\n","import { TEndpoint } from \"@shared/types/api\";\nimport { TOriginsLinkups } from \"@shared/types/candidate\";\nimport { TJobQuestions } from \"@shared/types/detail\";\nimport { TSendAnswers } from \"@shared/types/detail\";\nimport { getToken } from \"@shared/utils/auth/getToken.util\";\nimport { getAllUtms } from \"@shared/utils/url/getAllUtms.util\";\nimport { EVacantStates } from \"@shared/enums/vacantStates.enum\";\nimport { JobsRepository as SharedJobsRepository } from \"@shared/repositories/jobs.repository\";\nimport { TApplyData } from \"@shared/types/applyResponse\";\nexport class JobsWithAuthRepository extends SharedJobsRepository {\n  protected readonly endpoints: TEndpoint = {\n    jobs: {\n      search: \"/v1/jobs/search\",\n      detail: \"/v1/jobs/{jobSlug}\",\n      marks: \"/v1/jobs/setting/{id}\",\n      suggested: \"/v1/public/jobs/vacants/suggested/{jobSlug}\",\n      similar: \"/v2/jobs/suggested/mimir-wisdom\",\n      jobQuestionnaire: \"/v1/questionnaire/{jobId}\",\n      apply: \"/v1/jobs/apply\",\n      save: \"/v1/jobs/state\",\n      unsave: \"/v1/jobs/state/{jobId}/{state}\"\n    },\n    candidate: {\n      linkups: \"/v1/jobs/candidate/linkup-information\"\n    },\n    // TODO: Remove this endpoint in other repository\n    filters: {\n      countries: \"/v1/public/countries/{companySlug}\"\n    },\n    matcher: {\n      declineInvitation: \"/v1/matcher/decline\"\n    }\n  };\n\n  constructor() {\n    super();\n  }\n\n  protected async withBearer<TConfig extends { headers?: Record<string, string> } & Record<string, unknown>>(\n    config?: TConfig\n  ): Promise<TConfig> {\n    const token = await getToken();\n    const headers = {\n      ...(config?.headers ?? {}),\n      Authorization: `Bearer ${token}`\n    };\n    return { ...(config ?? ({} as TConfig)), headers };\n  }\n\n  async getJobQuestions(jobId: number): Promise<TJobQuestions> {\n    const response = await this.get<TJobQuestions>(\n      this.endpoints.jobs.jobQuestionnaire,\n      await this.withBearer({ params: { jobId } })\n    );\n    return response.data;\n  }\n\n  async applyJob(body: TSendAnswers) {\n    return this.post<TApplyData>(\n      this.endpoints.jobs.apply,\n      { ...body, utmPayload: getAllUtms() },\n      await this.withBearer()\n    );\n  }\n\n  async saveJob(jobId: number) {\n    return this.post(this.endpoints.jobs.save, { jobId }, await this.withBearer());\n  }\n\n  async unsaveJob(jobId: number) {\n    const state = EVacantStates.save;\n    return this.delete(this.endpoints.jobs.unsave, await this.withBearer({ params: { jobId, state } }));\n  }\n\n  async getOriginsAndLinkups(): Promise<TOriginsLinkups> {\n    const response = await this.get<TOriginsLinkups>(this.endpoints.candidate.linkups, await this.withBearer());\n    return response.data;\n  }\n}\n\nconst jobsWithAuthRepositoryInstance = new JobsWithAuthRepository();\nexport default jobsWithAuthRepositoryInstance;\n","import React, { JSX, use, useCallback, useEffect, useMemo, useState } from \"react\";\nimport { TCandidateCtx } from \"@shared/types/candidate\";\nimport { AuthContext } from \"@shared/context/auth.context\";\nimport CandidateRepositoryInstance from \"@shared/repositories/candidate.repository\";\nimport { isAvailableToApply } from \"@shared/utils/candidate/isAvailableToApply.util\";\nimport { ProfileConcreteObserver } from \"@shared/classes/profileConcreteObserver.class\";\nimport JobsWithAuthRepositoryInstance from \"@shared/repositories/jobsWithAuth.repository\";\nimport { CandidateContext, initCandidateContext } from \"@shared/context/candidate.context\";\nimport ProfileSubjectInstance, { ProfileSubject } from \"@shared/classes/profileSubject.class\";\n\nconst withCandidateHoc = <T,>(WrappedComponent: React.FC<T>) => {\n  const WithCandidate: React.FC<T & JSX.IntrinsicAttributes> = (props: T & JSX.IntrinsicAttributes) => {\n    const authContext = use(AuthContext);\n    const [candidateContext, setCandidateContext] = useState<TCandidateCtx>(initCandidateContext);\n\n    const callbackProfileComplete = useCallback((subject: ProfileSubject) => {\n      if (!subject.nextAction) return;\n      CandidateRepositoryInstance.getProfile().then(async (candidate) => {\n        const [candidateApplications, originsAndLinkups, termsAccepted] = await Promise.all([\n          CandidateRepositoryInstance.getCandidateApplicationCount(),\n          JobsWithAuthRepositoryInstance.getOriginsAndLinkups(),\n          CandidateRepositoryInstance.checkTerms()\n        ]);\n\n        setCandidateContext({\n          candidate,\n          candidateApplications,\n          originsAndLinkups,\n          availableToApply: isAvailableToApply(candidate),\n          termsAccepted\n        });\n      });\n    }, []);\n\n    const profileObserver = useMemo(() => {\n      return new ProfileConcreteObserver(callbackProfileComplete);\n    }, [callbackProfileComplete]);\n\n    useEffect(() => {\n      if (!authContext.isAuthenticated) return setCandidateContext(initCandidateContext);\n      CandidateRepositoryInstance.getProfile().then(async (candidate) => {\n        const [candidateApplications, originsAndLinkups, termsAccepted] = await Promise.all([\n          CandidateRepositoryInstance.getCandidateApplicationCount(),\n          JobsWithAuthRepositoryInstance.getOriginsAndLinkups(),\n          CandidateRepositoryInstance.checkTerms()\n        ]);\n\n        setCandidateContext({\n          candidate,\n          candidateApplications,\n          originsAndLinkups,\n          availableToApply: isAvailableToApply(candidate),\n          termsAccepted\n        });\n      });\n    }, [authContext.isAuthenticated, profileObserver]);\n\n    useEffect(() => {\n      ProfileSubjectInstance.attach(profileObserver);\n      return () => {\n        ProfileSubjectInstance.detach(profileObserver);\n      };\n    }, [profileObserver]);\n\n    return (\n      <CandidateContext.Provider value={candidateContext}>\n        <WrappedComponent {...props} />\n      </CandidateContext.Provider>\n    );\n  };\n\n  WithCandidate.displayName = \"WithCandidate\";\n\n  return WithCandidate;\n};\n\nexport default withCandidateHoc;\n","import { use, useState } from \"react\";\nimport { useTranslations } from \"next-intl\";\nimport dynamic from \"next/dynamic\";\nimport { useFilter } from \"@hooks/useFilter\";\nimport { TKeyAnswer } from \"@shared/types/detail\";\nimport { AuthContext } from \"@shared/context/auth.context\";\nimport { JobsContext } from \"@shared/context/jobs.context\";\nimport { EQueryAction } from \"@shared/enums/queryParams.enum\";\nimport DetailQuestionnaire from \"@components/jobOffers/offerDetail/children/detailQuestionnaire/component\";\n\nconst whiteListActions = [EQueryAction.apply, EQueryAction.save];\nconst JobDetailAction = dynamic(() => import(\"@components/jobOffers/detailAction/component\"));\n\nexport const useMagnetoJobDetailAction = (showInTab = false) => {\n  const t = useTranslations();\n  const { isAuthenticated } = use(AuthContext);\n  const [answers, setAnswers] = useState<TKeyAnswer>({});\n  const { setJobDetailAction, applyJobWithAnswer } = useFilter();\n  const { jobDetailAction, selectedJob, jobQuestions } = use(JobsContext);\n\n  if (!selectedJob) return null;\n  // EQueryAction.signUp is just for avoid typescript issue.\n  if (whiteListActions.includes(jobDetailAction ?? EQueryAction.signUp) && !isAuthenticated) {\n    return <JobDetailAction />;\n  }\n\n  if (!showInTab) return null;\n\n  const cancelApplyQuestions = () => {\n    setAnswers({});\n    setJobDetailAction(null);\n  };\n\n  if (jobDetailAction && jobQuestions?.id)\n    return (\n      <DetailQuestionnaire\n        t={t}\n        answers={answers}\n        setAnswers={setAnswers}\n        isMagnetoUIQuestionnaire\n        selectedJob={selectedJob}\n        jobQuestions={jobQuestions}\n        selectedJobId={selectedJob.id}\n        applyJobWithAnswer={applyJobWithAnswer}\n        cancelApplyQuestions={cancelApplyQuestions}\n      />\n    );\n};\n","import { useState } from \"react\";\nimport classNames from \"classnames/bind\";\nimport { useTranslations } from \"next-intl\";\nimport { ChatQuestionnaire, IQuestionnaireAnswer } from \"magneto365.ui/Domain/Jobs\";\nimport { MAX_LENGHT } from \"@shared/constants/inputLength.constant\";\nimport { EQuestionType } from \"@shared/enums/questionnaire.enum\";\nimport styles from \"./detailChatQuestionnaireOpen.module.scss\";\n\ninterface Props extends IQuestionnaireAnswer {\n  type: EQuestionType.openShort | EQuestionType.openLong;\n}\n\nconst cx = classNames.bind(styles);\n\nconst whiteListRegex = /[^a-zA-Z0-9\\s.,!?@#$%^&*()_+\\-=[\\]{};:'\"\\\\|<>/¿¡~`´]/g;\n\nexport const DetailChatQuestionnaireOpen: React.FC<Props> = ({ onChange, questionWithAnswer, className, type }) => {\n  const { answer, question, questionnaireId } = questionWithAnswer;\n  const t = useTranslations(\"registration\");\n  const maxLength = type === EQuestionType.openShort ? MAX_LENGHT.shortQuestionArea : MAX_LENGHT.longQuestionArea;\n  const [value, setValue] = useState<string>();\n  const [error, setError] = useState<boolean>(false);\n\n  if (answer && !(answer.type === EQuestionType.openShort || answer.type === EQuestionType.openLong)) return;\n\n  const handleChange = ({ target }: React.ChangeEvent<HTMLTextAreaElement>) => {\n    const cleanedValue = target.value.replaceAll(whiteListRegex, \"\");\n    setValue(cleanedValue);\n    setError(cleanedValue.length === 0);\n    return cleanedValue;\n  };\n\n  return (\n    <div>\n      <ChatQuestionnaire.Answer.Open\n        className={className}\n        value={value ?? answer?.openAnswer ?? \"\"}\n        onChange={handleChange}\n        maxLength={maxLength}\n        renderRight={({ classNameBtnSend, icon }) => (\n          <button\n            className={classNameBtnSend}\n            type=\"button\"\n            disabled={error}\n            onClick={() => {\n              const finalValue = handleChange({\n                target: { value: value ?? answer?.openAnswer ?? \"\" }\n              } as React.ChangeEvent<HTMLTextAreaElement>);\n\n              if (finalValue.length === 0) return;\n\n              onChange({\n                mode: \"readonly\",\n                question,\n                questionnaireId,\n                answer: {\n                  id: question.id,\n                  type,\n                  openAnswer: value ?? answer?.openAnswer ?? \"\"\n                }\n              });\n            }}\n          >\n            {icon}\n          </button>\n        )}\n      />\n      <div className={cx(\"message-error-container\")}>\n        {error && <span className={cx(\"message-error\")}>{t(\"form.required.field\")}</span>}\n      </div>\n    </div>\n  );\n};\n","export enum EQuestionAnswerType {\n  unique = 0,\n  multiple = 1,\n  openShort = 2,\n  openLong = 3\n}\n","import { EQuestionAnswerType } from \"@enums/questionAnswerType.enum\";\nimport { MAX_LENGHT } from \"@shared/constants/inputLength.constant\";\n\ntype CaptionByAnswerType = {\n  text: string;\n  params?: { length: string };\n};\n\nexport const CAPTION_BY_ANSWER_TYPE: Record<number, CaptionByAnswerType> = {\n  [EQuestionAnswerType.unique]: { text: \"chat.textHelpUniqueAnswer\" },\n  [EQuestionAnswerType.multiple]: { text: \"chat.textHelpMultipleAnswer\" },\n  [EQuestionAnswerType.openShort]: {\n    text: \"chat.textHelpOpenAnswer\",\n    params: { length: MAX_LENGHT.shortQuestionArea.toString() }\n  },\n  [EQuestionAnswerType.openLong]: {\n    text: \"chat.textHelpOpenAnswer\",\n    params: { length: MAX_LENGHT.longQuestionArea.toString() }\n  }\n};\n","import { CAPTION_BY_ANSWER_TYPE } from \"@constants/captionByAnswer.constant\";\nimport { Question, TQuestionnaires } from \"@shared/types/detail\";\nimport { useTranslations } from \"next-intl\";\n\ntype TTranslate = ReturnType<typeof useTranslations>;\n\nexport const addCaptionToQuestionnaires = (questionnaires: TQuestionnaires[], t: TTranslate) => {\n  return questionnaires.map((questionnaire) => ({\n    ...questionnaire,\n    questions: questionnaire.questions.map((question: Question) => ({\n      ...question,\n      caption:\n        t(CAPTION_BY_ANSWER_TYPE[question.answerType].text, CAPTION_BY_ANSWER_TYPE[question.answerType].params) ?? \"\"\n    }))\n  }));\n};\n","import { useEffect, useRef } from \"react\";\nimport classNames from \"classnames/bind\";\nimport { useTranslations } from \"next-intl\";\nimport { ChatQuestionnaire } from \"magneto365.ui/Domain/Jobs\";\nimport { TQuestionnaires, TSendQuestion, TSendQuestionnaire } from \"@shared/types/detail\";\nimport { EQuestionType } from \"@shared/enums/questionnaire.enum\";\nimport { DetailChatQuestionnaireOpen } from \"../detailChatQuestionnaireOpen/component\";\nimport styles from \"./detailChatQuestionnaireChat.module.scss\";\nimport { addCaptionToQuestionnaires } from \"@utils/jobOffers/addCaptionToQuestionnaires.util\";\n\nconst cx = classNames.bind(styles);\n\ninterface Props {\n  questionnaires: TQuestionnaires[];\n  onAnswer?: (answers: TSendQuestionnaire[]) => void;\n  onBack?: VoidFunction;\n}\n\nexport const DetailChatQuestionnaireChat: React.FC<Props> = ({ questionnaires, onBack, onAnswer }) => {\n  const t = useTranslations(\"jobOffers\");\n  const questionnairesWithCaptions = addCaptionToQuestionnaires(questionnaires, t);\n  const { next, saveAnswer, chat, getAnswers, isCompleted } = ChatQuestionnaire.useChat(questionnairesWithCaptions);\n  const executed = useRef(false);\n\n  useEffect(() => {\n    if (executed.current) return;\n    next();\n    executed.current = true;\n  }, [next, chat]);\n\n  return (\n    <div className={cx(\"container\")}>\n      <ChatQuestionnaire.Header onBack={onBack}>\n        {t(\"chat.answerToForwardWithYourApplication\")}\n      </ChatQuestionnaire.Header>\n      <ChatQuestionnaire className={cx(\"chat\")} ref={chat}>\n        {(messages) =>\n          messages.map(({ content }) => (\n            <ChatQuestionnaire.Question waitFor={2000} key={content.question.id} questionWithAnswer={content}>\n              <ChatQuestionnaire.MessageCandidate questionWithAnswer={content} onChange={saveAnswer}>\n                {content.question.answerType === EQuestionType.unique && (\n                  <ChatQuestionnaire.Answer.UniqueChoice\n                    className={cx(\"chat__unique\")}\n                    questionWithAnswer={content}\n                    onChange={saveAnswer}\n                  />\n                )}\n                {content.question.answerType === EQuestionType.multiple && (\n                  <ChatQuestionnaire.Answer.MultipleChoice\n                    className={cx(\"chat__multiple\")}\n                    questionWithAnswer={content}\n                    onChange={saveAnswer}\n                    renderSubmitButton={(args) => (\n                      <button {...args} className={cx(args.className, \"chat__message-button\")}>\n                        {t(\"actions.save\")}\n                      </button>\n                    )}\n                  />\n                )}\n                {(content.question.answerType === EQuestionType.openShort ||\n                  content.question.answerType === EQuestionType.openLong) && (\n                  <DetailChatQuestionnaireOpen\n                    type={content.question.answerType}\n                    onChange={saveAnswer}\n                    questionWithAnswer={content}\n                  />\n                )}\n              </ChatQuestionnaire.MessageCandidate>\n            </ChatQuestionnaire.Question>\n          ))\n        }\n      </ChatQuestionnaire>\n      <footer className={cx(\"chat__footer\")}>\n        <ChatQuestionnaire.Button className={cx(\"chat__cancel\")} onClick={() => onBack?.()}>\n          {t(\"actions.cancel\")}\n        </ChatQuestionnaire.Button>\n        <ChatQuestionnaire.Button\n          className={cx(\"chat__submit\")}\n          disabled={!isCompleted}\n          variant=\"green\"\n          onClick={() => {\n            onAnswer?.(\n              getAnswers().map<TSendQuestionnaire>(({ id, questions }) => ({\n                id,\n                questions: questions\n                  .map<TSendQuestion | undefined>(({ id, type, ...rest }) => {\n                    if (\"openAnswer\" in rest && typeof rest.openAnswer === \"string\") {\n                      return {\n                        id,\n                        type: type as EQuestionType.openShort | EQuestionType.openLong,\n                        openAnswer: rest.openAnswer\n                      };\n                    } else if (\"answer\" in rest && rest.answer) {\n                      return {\n                        id,\n                        type: type as EQuestionType.multiple | EQuestionType.unique,\n                        answer: rest.answer.map(({ id }) => id)\n                      };\n                    }\n                  })\n                  .filter((question) => question !== undefined)\n              }))\n            );\n          }}\n        >\n          {t(\"offer.sendAnswers\")}\n        </ChatQuestionnaire.Button>\n      </footer>\n    </div>\n  );\n};\n","export default {\"src\":\"https://static.magneto365.com/jobs/co/_next/static/media/alert.0186f0c0.png\",\"height\":368,\"width\":368,\"blurDataURL\":\"data:image/png;base64,\",\"blurWidth\":8,\"blurHeight\":8};","import Image from \"next/image\";\nimport classNames from \"classnames/bind\";\nimport { Typography } from \"magneto365.ui\";\nimport { useTranslations } from \"next-intl\";\nimport { ChatQuestionnaire } from \"magneto365.ui/Domain/Jobs\";\nimport { ASSETS_ICONS } from \"@constants/assets.constant\";\nimport { getIconPath } from \"@utils/assets/getAsset.util\";\nimport AlertIcon from \"../../../../../../../assets/images/icons/alert.png\";\nimport styles from \"./detailChatQuestionnaireConfirm.module.scss\";\n\ninterface Props {\n  onConfirm?: VoidFunction;\n  onCancel?: VoidFunction;\n}\n\nconst cx = classNames.bind(styles);\n\nexport const DetailChatQuestionnaireConfirm: React.FC<Props> = ({ onConfirm, onCancel }) => {\n  const t = useTranslations(\"jobOffers\");\n  const tRegister = useTranslations(\"registration\");\n  return (\n    <article className={cx(\"article\")}>\n      <header className={cx(\"header\")}>\n        <Image src={AlertIcon} alt=\"alert\" width={27} height={27} />\n        <Typography.Title level={3} weight=\"bold\" size=\"lg\">\n          {t(\"chat.areYouSureToExitProcess\")}\n        </Typography.Title>\n      </header>\n      <Typography.Text weight=\"normal\" size=\"lg\" color=\"grey-800\">\n        {t(\"chat.ifYouExitNow\")}\n      </Typography.Text>\n      <footer className={cx(\"footer\")}>\n        <ChatQuestionnaire.Button className={cx(\"footer__cancel\")} onClick={onConfirm}>\n          <Typography.Text weight=\"bold\" size=\"lg\">\n            {tRegister(\"landing.goOut\")}\n          </Typography.Text>\n        </ChatQuestionnaire.Button>\n        <ChatQuestionnaire.Button className={cx(\"footer__confirm\")} variant=\"blue\" onClick={onCancel}>\n          <Typography.Text weight=\"bold\" size=\"lg\" color=\"grey-50\">\n            {t(\"chat.continueWithApplication\")}\n          </Typography.Text>\n          <Image\n            className={cx(\"icon--white\")}\n            src={getIconPath(ASSETS_ICONS.ARROW_RIGHT)}\n            alt=\"confirm\"\n            width={6}\n            height={12}\n          />\n        </ChatQuestionnaire.Button>\n      </footer>\n    </article>\n  );\n};\n","import { useState } from \"react\";\nimport { Drawer } from \"antd\";\ni