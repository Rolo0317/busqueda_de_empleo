 tJobs(\"offer.whatsappName\"),\n        ariaLabel: tJobs(\"actions.shareViaWhatsapp\"),\n        href: `https://api.whatsapp.com/send?text=${encodeURIComponent(\n          tJobs(\"offer.checkOutThisJobOffer\") + \" \" + detailUrl\n        )}`,\n        name: \"WhatsApp\"\n      },\n      {\n        title: tJobs(\"offer.linkedinName\"),\n        ariaLabel: tJobs(\"actions.shareViaLinkedin\"),\n        href: `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(detailUrl)}`,\n        name: \"LinkedIn\"\n      },\n      {\n        title: tJobs(\"offer.XName\"),\n        ariaLabel: tJobs(\"actions.shareViaX\"),\n        href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(detailUrl)}`,\n        name: \"X\"\n      },\n      {\n        title: tJobs(\"offer.mail\"),\n        ariaLabel: tJobs(\"actions.shareViaEmail\"),\n        href: `mailto:?subject=${encodeURIComponent(\n          tJobs(\"offer.checkOutThisJobOffer\")\n        )}&body=${encodeURIComponent(tJobs(\"offer.checkOutThisJobOffer\") + \" \" + detailUrl)}`,\n        name: \"Sms\"\n      }\n    ],\n    [detailUrl, tJobs]\n  );\n\n  useEffect(() => {\n    const action = query.get(\"action\");\n    if (action === \"apply\" && candidate && params.jobSlug) {\n      const interval = setInterval(() => {\n        const btn = document.getElementById(\"auth-button-apply\");\n        if (btn) {\n          setTimeout(() => {\n            ch.dispatch(\"apply\", { from: \"JobOfferDetailActions\" });\n          }, 2000);\n          clearInterval(interval);\n        }\n      }, 100);\n\n      return () => clearInterval(interval);\n    }\n  }, [candidate, ch, isAuthenticated, params.jobSlug, query]);\n\n  if (!selectedJob) return null;\n\n  return (\n    <section\n      className={cx(\"job-offer-actions\", \"job-offer-actions--without-linkedin\", {\n        \"job-offer-actions--detail\": showInTab\n      })}\n    >\n      {!hideApplyButton && (\n        <RenderApplyButton\n          className={cx