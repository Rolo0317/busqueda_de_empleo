l: string;\n  isApplied: boolean;\n  parentId?: string | number;\n};\n\ntype TGetOptionsOnSearchProps = {\n  repository: Omit<TFilterRepository, \"type\" | \"fieldAlias\"> & { type: string };\n  field: string;\n  value: string;\n  params?: number[] | string[];\n};\n\ntype TRepositoriesResult = {\n  repository: typeof JobsRepository;\n  filtersRepository: typeof FiltersRepository;\n};\n\ntype TAnswerQuestionaryAdapter = {\n  previousAction: EQueryAction | null;\n  answers: TSendAnswers | null;\n};\n\ntype TUseFilterReturn = {\n  totalAppliedFilters: number;\n  loading: boolean;\n  totalRows: number;\n  totalHits: number;\n  appliedFilters: TRequestSearch;\n  filterSettings: TGlobalFilterSettings;\n  device: EDeviceTypes;\n  searchResponse: TSearchResponse<TJobRecord>;\n  h1?: string | undefined;\n  rows: TJobRecord[];\n  magnetoUIActiveFilters: TMagnetoUIActiveFilter[];\n\n  setFilters: (payload: TRequestSearch) => Promise<void>;\n  setIsApplied: (filter: TSetIsAppliedProps) => Promise<void>;\n  clearFilters: () => Promise<void>;\n  unApplyWithChild: (withChild: TUnApplyWithChildProps) => Promise<void>;\n  getOptionsOnLoad: (field: string, values: (string | number)[]) => Promise<TSearchRenderTypeOption[]>;\n  getOptionsOnSearch: (term: TGetOptionsOnSearchProps) => Promise<TSearchRenderTypeOption[]>;\n  changeOfferState: (jobId: number | null, view: string, isSaved: boolean | null) => Promise<void>;\n  setJobDetailAction: (jobId: number | null, action?: EQueryAction, job?: Partial<TJobRecord>) => Promise<void>;\n  applyJobWithAnswer: (answers: TSendAnswers, action?: EQueryAction, tagManager?: () => void) => Promise<void>;\n  setJobSelected: (record: TJobRecord | null) => void;\n};\n\nexport const useFilter = (): TUseFilterReturn => {\n  const t = useTranslations();\n  const { isAuthenticated } = useContext(AuthContext);\n  const { candidate } = useContext(CandidateContext);\n  const jobsContext = useContext(JobsContext);\n  const landingContext = useContext(LandingContext);\n  const query = useParams();\n  const querySearch = useSearchParams();\n  const pathname = usePathname();\n  const { landingPage } = landingContext;\n  const ch = useContext(BroadcastContext);\n  const { open } = useContext(SignUpContext);\n  const { setViewAISuggestedVacancies } = useAISuggestedContext();\n  const { setAISuggestedVacancies } = useAISuggestedContext();\n  const copyAnswerQuestionaryRef = useRef<TAnswerQuestionaryAdapter>(INIT_COPY_QUESTIONARY);\n\n  const {\n    loading,\n    filtersApplied: appliedFilters,\n    filterSettings: { filters },\n    searchResponse: { counters, totalRows, rows, totalHits },\n    selectedJob,\n    setContextValue: setJobsContext\n  } = jobsContext;\n\n  const { repository, filtersRepository } = useMemo<TRepositoriesResult>(() => {\n    return { repository: JobsRepository, filtersRepository: FiltersRepository };\n  }, []);\n\n  const magnetoUIActiveFilters = useMemo(() => {\n    return normalizeFilter({\n      filters,\n      counters,\n      applied: appliedFilters?.filters,\n      t\n    });\n  }, [filters, counters, appliedFilters?.filters, t]);\n\n  const totalAppliedFilters: number = useMemo(() => {\n    return Object.entries(appliedFilters.filters).reduce(totalAppliedFiltersReducer({ filters }), 0);\n  }, [appliedFilters.filters, filters]);\n\n  const updateAiSuggestedVacancies = (jobId: number, applyStatus: EApplicationStatus | null) => {\n    setAISuggestedVacancies((current) =>\n      current.map((job) =>\n        job.id === jobId\n          ? {\n              ...job,\n              isApplied: applyStatus === EApplicationStatus.applied,\n              isPreApplied: applyStatus === EApplicationStatus.preApplied\n            }\n          : job\n      )\n    );\n  };\n\n  const sourceOrigins = useMemo<TSourceOrigins>(() => {\n    const fMagnetoParam = fMagnetoAdapter(query?.[\"f_magneto\"]);\n    const isPublicJobsite = isPublicJobsiteAdapter(landingContext.landingPage);\n    return {\n      // eslint-disable-next-line camelcase\n      f_magneto: fMagnetoParam,\n      isPublicJobsite\n    };\n  }, [query, landingContext]);\n\n  useRefreshSearchOnAuth({\n    isAuthenticated,\n    appliedFilters,\n    search: (payload) => repository.search(payload),\n    setContextValue: setJobsContext\n  });\n\n  const setSimilarVacancies = async (vacantId: number | null, companyId?: number | null) => {\n    const similarVacancies: TSimilarVacancies[] = await repository.getSimilarVacancies(vacantId, companyId);\n    setJobsContext((current) => ({ ...current, similarVacancies }));\n  };\n\n  const setJobSelected = (record: TJobRecord | null) => {\n    let nextSelectedId: number | null = null;\n\n    setJobsContext((current) => {\n      const currentSelectedId = current.selectedJob?.id ?? null;\n      const incomingSelectedId = record?.id ?? null;\n      const isSameRecord = currentSelectedId === incomingSelectedId;\n\n      if (current.isApplying && !isSameRecord) {\n        return current;\n      }\n      const shouldReleaseLock = current.isApplying && isSameRecord;\n      if (incomingSelectedId !== null && !isSameRecord) {\n        nextSelectedId = incomingSelectedId;\n      }\n\n      return {\n        ...current,\n        selectedJob: record,\n        offerSuggested: [],\n        jobQuestions: null,\n        jobDetailAction: null,\n        isApplying: shouldReleaseLock ? false : record ? current.isApplying : false\n      };\n    });\n\n    if (nextSelectedId !== null) {\n      void setSimilarVacancies(nextSelectedId, landingPage?.companyId);\n    }\n  };\n\n  const setFilters = async (payload: TRequestSearch) => {\n    setJobsContext((current) => ({\n      ...current,\n      filtersApplied: payload,\n      offerSuggested: [],\n      jobQuestions: null,\n      loading: true,\n      isApplying: false\n    }));\n    try {\n      const searchResponse = await repository.search(payload);\n      const selectedJob = jobsContext.selectedJob || searchResponse.rows[0] || null;\n      const similarVacancies: TSimilarVacancies[] =\n        (selectedJob && (await repository.getSimilarVacancies(selectedJob.id, landingPage?.companyId))) || [];\n\n      setJobsContext((current) => ({\n        ...current,\n        searchResponse,\n        selectedJob,\n        similarVacancies,\n        loading: false,\n        isApplying: false\n      }));\n      if (isNonEmptyArray(searchResponse.rows))\n        TagManagerRepository.viewItemList(\n          jsonDataLayer(\n            searchResponse.rows,\n            EViewItemListName.generalOffers.replace(\n              \"{query}\",\n              querySearch ? querySearch.toString() : EViewItemListName.enColombia\n            ),\n            viewItemListSectionFromRoute({ query, pathName: pathname }),\n            EEventsGA4.viewItemList,\n            { page: payload.paginator.page }\n          )\n        );\n    } catch {\n      setJobsContext((current) => ({\n        ...current,\n        loading: false,\n        isApplying: false\n      }));\n    }\n\n    await stateToQueryParams({ ...payload, ...getAllUtms() }, jobsContext.filterSettings);\n  };\n\n  // method for apply filters just when applied to a one vacant\n  const filtersFromApply = async (applyStatus: EApplicationStatus | null = null, jobId: number | null = null) => {\n    suggestedVacancySingleton.clear();\n    setJobsContext((current) => ({\n      ...current,\n      offerSuggested: [],\n      jobQuestions: null,\n      jobDetailAction: null\n    }));\n    if (jobId) {\n      return updateAiSuggestedVacancies(jobId, applyStatus);\n    }\n\n    try {\n      const similarVacancies: TSimilarVacancies[] =\n        (selectedJob && (await repository.getSimilarVacancies(selectedJob.id, landingPage?.companyId))) || [];\n      const rows = jobsContext.searchResponse.rows.map((job) => {\n        if (selectedJob && job.id === selectedJob.id) {\n          return {\n            ...job,\n            isApplied: applyStatus == EApplicationStatus.applied,\n            isPreApplied: applyStatus == EApplicationStatus.preApplied\n          };\n        } else return job;\n      }) as TJobRecord[];\n\n      setViewAISuggestedVacancies(true);\n\n      setJobsContext((current) => ({\n        ...current,\n        selectedJob: {\n          ...selectedJob,\n          isApplied: applyStatus == EApplicationStatus.applied,\n          isPreApplied: applyStatus == EApplicationStatus.preApplied\n        } as TJobRecord,\n        searchResponse: { ...jobsContext.searchResponse, rows },\n        similarVacancies,\n        isApplying: false,\n        jobDetailAction: null\n      }));\n      if (isNonEmptyArray(jobsContext.searchResponse.rows))\n        TagManagerRepository.viewItemList(\n          jsonDataLayer(\n            jobsContext.searchResponse.rows,\n            EViewItemListName.generalOffers.replace(\n              \"{query}\",\n              querySearch ? querySearch.toString() : EViewItemListName.enColombia\n            ),\n            viewItemListSectionFromRoute({ query, pathName: pathname }),\n            EEventsGA4.viewItemList,\n            { page: appliedFilters.paginator.page }\n          )\n        );\n    } catch {\n      setJobsContext((current) => ({ ...current, isApplying: false }));\n      throw new Error(\"Error on apply filters after apply job\");\n    }\n  };\n\n  const setIsApplied = ({ id, field, isApplied, multiple }: TSetIsAppliedProps) => {\n    const { filters: currentFilters } = appliedFilters;\n    const filterSelected = isApplied\n      ? [...currentFilters[field].filter((item) => item !== id)]\n      : [...currentFilters[field], id];\n    return setFilters({\n      ...appliedFilters,\n      filters: { ...appliedFilters.filters, [field]: multiple ? filterSelected : isApplied ? [] : [id] },\n      paginator: { ...appliedFilters.paginator, page: 1 }\n    });\n  };\n\n  const clearFilters = async () => {\n    if (!totalAppliedFilters) return;\n    const emptyFilters: TRequestFilter = {};\n    for (const filed in appliedFilters.filters) {\n      if ([\"locations\", \"company_show_slug\"].includes(filed)) {\n        emptyFilters[filed] = appliedFilters.filters[filed];\n      } else {\n        emptyFilters[filed] = [];\n      }\n    }\n    return setFilters({\n      ...appliedFilters,\n      filters: emptyFilters,\n      paginator: { ...appliedFilters.paginator, page: 1 }\n    });\n  };\n\n  const unApplyWithChild = ({ child, parentId, parentField, newParentId }: TUnApplyWithChildProps) => {\n    const [splitParentId] =\n      typeof parentId === \"string\" && parentId.includes(\"@\") ? parentId.split(\"@\") : [String(parentId)];\n    const newChildren: string[] = [];\n    child.filtersApplied?.forEach((deepChild) => {\n      if (typeof deepChild !== \"string\") return;\n      const [, deepParentId] = deepChild.split(\"@\");\n      if (String(deepParentId) !== String(splitParentId)) newChildren.push(deepChild);\n    });\n    const newParents = newParentId\n      ? [...appliedFilters.filters[parentField].filter((item) => item !== parentId), newParentId]\n      : [...appliedFilters.filters[parentField].filter((item) => item !== parentId)];\n    const newFilters = child.child\n      ? { ...appliedFilters.filters, [child.field]: newChildren, [parentField]: newParents, [child.child.field]: [] }\n      : { ...appliedFilters.filters, [child.field]: newChildren, [parentField]: newParents };\n    return setFilters({\n      ...appliedFilters,\n      filters: newFilters,\n      paginator: { ...appliedFilters.paginator, page: 1 }\n    });\n  };\n\n  const getOptionsOnLoad = useCallback(\n    async (field: string, values: (string | number)[]): Promise<TSearchRenderTypeOption[]> => {\n      const labels = await filtersRepository.findLabels({ filters: { [field]: values } }).then((labels) => {\n        return labels[field].map((item) => ({ ...item, isApplied: true }));\n      });\n      return labels;\n    },\n    [filtersRepository]\n  );\n\n  const getOptionsOnSearch = async (term: TGetOptionsOnSearchProps) => {\n    const foundOptions = await filtersRepository.findOptions({\n      filters: term.params,\n      term: term.value,\n      field: term.field,\n      source: term.repository.source\n    });\n    return foundOptions.map((opt) => ({ ...opt, isApplied: false }));\n  };\n\n  const setJobDetailAction = async (\n    jobId: number | null,\n    action = EQueryAction.apply,\n    job: Partial<TJobRecord> | null = null\n  ) => {\n    if (job && job.id) {\n      suggestedVacancySingleton.setId(job);\n    }\n    const jobToUse = job || selectedJob;\n    copyAnswerQuestionaryRef.current.previousAction = action;\n    const shouldLockSelection =\n      action === EQueryAction.apply || action === EQueryAction.continueProcess || action === EQueryAction.signUp;\n\n    if (!jobId) {\n      removeQueryParamByWindow(EQueryParams.action);\n      return setJobsContext((current) => ({\n        ...current,\n        jobQuestions: null,\n        jobDetailAction: null,\n        isApplying: false\n      }));\n    }\n\n    setJobsContext((current) => ({\n      ...current,\n      jobDetailAction: action,\n      isApplying: shouldLockSelection ? true : current.isApplying\n    }));\n\n    if (!isAuthenticated) {\n      return;\n    }\n\n    const offerHasQuestionnaire = jobToUse?.hasPrefilterQuestionnaire;\n    if (offerHasQuestionnaire) {\n      if (action === EQueryAction.continueProcess && copyAnswerQuestionaryRef.current?.answers) {\n        applyJobWithAnswer(copyAnswerQuestionaryRef.current.answers, EQueryAction.continueProcess);\n      }\n\n      const jobQuestions: TJobQuestions = await JobsRepository.getJobQuestions(jobToUse.id!);\n      return setJobsContext((current) => ({\n        ...current,\n        jobQuestions,\n        jobDetailAction: EQueryAction.apply,\n        isApplying: true\n      }));\n    }\n\n    if (jobToUse?.id && action === EQueryAction.apply && (await hasElementInSignUpSchema(jobToUse.id.toString()))) {\n      setJobsContext((current) => ({ ...current, isApplying: true }));\n      open({\n        vacantId: jobToUse.id.toString(),\n        mode: \"APPLY_WITH_AUTH\"\n      });\n      return;\n    }\n\n    if (applicationsSingleton.hasApplication(jobToUse!.id!)) return;\n    applicationsSingleton.addApplication(jobToUse!.id!);\n    const suggestedByMatcher = getSuggestedByMatcher(query);\n    return JobsRepository.applyJob({ jobId: jobToUse!.id!, suggestedByMatcher, sourceOrigins })\n      .then((applyResponse) => {\n        applicationsSingleton.completeApplication(jobToUse!.id!);\n        const data = applyResponse.data as TApplyData;\n        TagManagerRepository.purchaseV4(\n          jsonDataLayer(\n            [jobToUse as TJobRecord],\n            EViewItemListName.generalOffers.replace(\n              \"{query}\",\n              querySearch ? querySearch.toString() : EViewItemListName.enColombia\n            ),\n            viewItemListSectionFromRoute({ query, pathName: pathname }, !!jobToUse),\n            EEventsGA4.purchase,\n            {\n              applicationId: applyResponse.data.applicationId,\n              segment: String(jobsContext.selectedJob?.companySegment)\n            },\n            candidate || undefined\n          )\n        );\n        ch.dispatch(\n          \"applied\",\n          appliedResponseAdapter(data, {\n            companyLogo: jobToUse?.companyLogo?.url,\n            companyName: jobToUse?.companyName,\n            title: jobToUse?.title\n          })\n        );\n        NotificationsRepository.updateNotificationPreferences(ACTIVE_PROCESS_CHANNELS);\n        copyAnswerQuestionaryRef.current = INIT_COPY_QUESTIONARY;\n\n        const applyStatus = \"applicationId\" in data ? EApplicationStatus.applied : EApplicationStatus.preApplied;\n\n        return filtersFromApply(applyStatus, job?.id);\n      })\n      .catch((error) => {\n        applicationsSingleton.completeApplication(jobId as number);\n        setJobsContext((current) => ({ ...current, isApplying: false }));\n        throw error;\n      });\n  };\n\n  const changeOfferState = async (jobId: number | null, view: string, isSaved: boolean | null) => {\n    if (!isAuthenticated) {\n      setJobDetailAction(jobId, EQueryAction.save);\n      return;\n    }\n    try {\n      if (isSaved) JobsRepository.unsaveJob(jobId as number);\n      else JobsRepository.saveJob(jobId as number);\n\n      message.success(t(`jobOffers.message.${isSaved ? \"unSaved\" : \"saved\"}`));\n    } catch {\n      message.error(t(\"jobOffers.error.message\"));\n      return;\n    }\n    try {\n      if (view === EVacantViews.row || view === EVacantViews.listMode) {\n        setJobsContext((current) => ({ ...current, loading: true }));\n        const searchResponse = await repository.search(appliedFilters);\n        setJobsContext((current) => ({ ...current, searchResponse, loading: false }));\n\n        if (view === EVacantViews.listMode) {\n          const selectOffer = searchResponse.rows.find((row) => row.id === selectedJob?.id) as TJobRecord;\n          setJobSelected(selectOffer);\n        }\n      }\n\n      if (view === EVacantViews.detailPage) {\n        const selectOffer = await repository.getSelectedJob(jobId?.toString() as string, undefined, true);\n        setJobSelected(selectOffer);\n      }\n    } catch {\n      setJobsContext((current) => ({ ...current, loading: false }));\n    }\n  };\n\n  const applyJobWithAnswer = async (answers: TSendAnswers, action?: EQueryAction) => {\n    if (!suggestedVacancySingleton.getId()) {\n      if (\n        selectedJob?.templateId &&\n        action !== EQueryAction.continueProcess &&\n        copyAnswerQuestionaryRef.current.previousAction !== EQueryAction.signUp &&\n        (await hasElementInSignUpSchema(selectedJob.id?.toString() ?? \"\"))\n      ) {\n        copyAnswerQuestionaryRef.current.answers = answers;\n        open({\n          vacantId: selectedJob.id?.toString() ?? \"\",\n          mode: \"APPLY_WITH_AUTH\"\n        });\n        return;\n      }\n 