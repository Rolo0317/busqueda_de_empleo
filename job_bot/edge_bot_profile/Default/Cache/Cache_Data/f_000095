  routePath: \"\",\n        baseUrl: marbleUrl,\n        isExternal: true\n      },\n      {\n        tag: \"footer.links.library\",\n        routePath: \"\",\n        baseUrl: digitalLibrarysUrl,\n        isExternal: true\n      }\n    ]\n  },\n  legalMenu: {\n    heightContent: 335,\n    title: \"footer.titles.legal\",\n    links: [\n      {\n        tag: \"footer.links.personalDataMagneto\",\n        routePath: \"\",\n        baseUrl: personalDataMagneto,\n        isExternal: true\n      },\n      {\n        tag: \"footer.links.dataProcessingAuthorization\",\n        routePath: \"\",\n        baseUrl: dataProcessingAuthorization,\n        isExternal: true\n      },\n      {\n        tag: \"footer.links.termsAndConditions\",\n        routePath: \"\",\n        baseUrl: termsAndConditions,\n        isExternal: true\n      },\n      {\n        tag: \"footer.links.authorizationRegulations\",\n        routePath: \"\",\n        baseUrl: authorizationRegulations,\n        isExternal: true\n      },\n      {\n        tag: \"footer.links.ethicsLineForm\",\n        routePath: \"\",\n        baseUrl: ethicsLineForm,\n        isExternal: true\n      },\n      {\n        tag: \"footer.links.sustainability\",\n        routePath: \"\",\n        baseUrl: sustainability,\n        isExternal: true\n      }\n    ]\n  }\n};\n\nconst APP_OVERRIDES = {\n  home: {\n    personsMenu: {\n      links: {\n        jobsByCompany: { isExternal: true },\n        registerResume: { baseUrl: \"?action=sign-up\" }\n      }\n    }\n    // legalMenu: { links: { sustainability: { baseUrl: policies } } }\n  },\n  jobs: {\n    personsMenu: {\n      links: {\n        registerResume: { isCreateAccount: true }\n      }\n    }\n    // legalMenu: { links: { sustainability: { baseUrl: sustainability } } }\n  }\n};\n\nexport const getFooterConfig = (appName: TApp): TFooterConfig => {\n  const config = JSON.parse(JSON.stringify(footerMagnetoUI));\n  const overrides = APP_OVERRIDES[appName] || {};\n\n  Object.entries(overrides).forEach(([menu, changes]) => {\n    try {\n      if (changes.links) {\n        Object.entries(changes.links).forEach(([linkKey, changes]) => {\n          const link = config[menu].links.find((l: { tag: string }) => l.tag.includes(linkKey));\n          if (link) Object.assign(link, changes);\n        });\n      }\n    } catch (e) {\n      console.error(`Error applying overrides for ${menu}`, e);\n    }\n  });\n\n  return config;\n};\n","\"use client\";\nimport { useCallback, useMemo } from \"react\";\nimport { getFooterConfig } from \"@shared/schemas/footer/footerMagnetoUI.schema\";\nimport { useSearchParams } from \"next/navigation\";\nimport { SPEResolution0070, siteMap } from \"@shared/constants/companyLinks.constant\";\nimport useSignupWidget from \"@shared/hooks/useSignupWidget\";\nimport { TFunction } from \"@shared/types/locales\";\nimport { fillUrlUtms } from \"@shared/utils/url/fillUrlUtms.util\";\nimport { TApp } from \"@shared/types/layout\";\n\ntype TProps = {\n  t: TFunction;\n  isAuthenticated: boolean;\n  appType: TApp;\n  onClose?: React.Dispatch<React.SetStateAction<boolean>>;\n};\n\nconst useMagnetoFooter = ({ t, onClose, isAuthenticated, appType }: TProps) => {\n  const query = useSearchParams();\n  const { personsMenu, magnetoMenu, magnetoLiteMenu, otherSolutionsMenu, legalMenu } = getFooterConfig(appType);\n\n  const { loading, onClickHandle } = useSignupWidget({ t, onClose });\n\n  const urlCompanyPages = useCallback(\n    ({ routePath, baseUrl }: { routePath: string; baseUrl: string }) => {\n      const path = routePath && !routePath.startsWith(\"/\") ? t(routePath) : routePath;\n      return fillUrlUtms(`${baseUrl}${path}`, query);\n    },\n    [t, query]\n  );\n\n  const footerProps = useMemo(() => {\n    const rightsReservedProps = {\n      magnetoRightsText: t(\"footer.rightsReserved\"),\n      mapSiteHref: fillUrlUtms(siteMap, query),\n      mapSiteText: t(\"footer.siteMap\")\n    };\n\n    const magnetoResolutionProps = {\n      resolutionText: t(\"footer.linked\"),\n      resolutionHref: fillUrlUtms(SPEResolution0070, query),\n      resolutionHrefText: t(\"footer.resolution\")\n    };\n\n    const followText = t(\"footer.titles.socialMedia\");\n\n    const menuFooterLink = {\n      personsMenu: {\n        title: t(personsMenu.title),\n        heightContent: isAuthenticated ? 280 : personsMenu.heightContent,\n        createAccount: onClickHandle,\n        isLoading: loading,\n        links: personsMenu.links.map(({ tag, ...rest }) => ({\n          ...rest,\n          tag: (tag.includes(\"login\") || tag.includes(\"registerResume\")) && isAuthenticated ? null : t(tag),\n          href: urlCompanyPages(rest)\n        }))\n      },\n      magnetoMenu: {\n        title: t(magnetoMenu.title),\n        heightContent: magnetoMenu.heightContent,\n        links: magnetoMenu.links.map(({ tag, ...rest }) => ({\n          ...rest,\n          tag: t(tag),\n          href: urlCompanyPages(rest)\n        }))\n      },\n      magnetoLiteMenu: {\n        title: t(magnetoLiteMenu.title),\n        heightContent: magnetoLiteMenu.heightContent,\n        links: magnetoLiteMenu.links.map(({ tag, ...rest }) => ({\n          ...rest,\n          tag: t(tag),\n          href: urlCompanyPages(rest)\n        }))\n      },\n      otherSolutionsMenu: {\n        title: t(otherSolutionsMenu.title),\n        heightContent: otherSolutionsMenu.heightContent,\n        links: otherSolutionsMenu.links.map(({ tag, ...rest }) => ({\n          ...rest,\n          tag: t(tag),\n          href: urlCompanyPages(rest)\n        }))\n      },\n      legalMenu: {\n        title: t(legalMenu.title),\n        heightContent: legalMenu.heightContent,\n        links: legalMenu.links.map(({ tag, ...rest }) => ({\n          ...rest,\n          tag: t(tag),\n          href: urlCompanyPages(rest)\n        }))\n      }\n    };\n\n    return { rightsReservedProps, magnetoResolutionProps, followText, menuFooterLink };\n  }, [\n    query,\n    