oString(prefix) + id;\n}\n\nmodule.exports = uniqueId;\n","var baseTrim = require('./_baseTrim'),\n    isObject = require('./isObject'),\n    isSymbol = require('./isSymbol');\n\n/** Used as references for various `Number` constants. */\nvar NAN = 0 / 0;\n\n/** Used to detect bad signed hexadecimal string values. */\nvar reIsBadHex = /^[-+]0x[0-9a-f]+$/i;\n\n/** Used to detect binary string values. */\nvar reIsBinary = /^0b[01]+$/i;\n\n/** Used to detect octal string values. */\nvar reIsOctal = /^0o[0-7]+$/i;\n\n/** Built-in method references without a dependency on `root`. */\nvar freeParseInt = parseInt;\n\n/**\n * Converts `value` to a number.\n *\n * @static\n * @memberOf _\n * @since 4.0.0\n * @category Lang\n * @param {*} value The value to process.\n * @returns {number} Returns the number.\n * @example\n *\n * _.toNumber(3.2);\n * // => 3.2\n *\n * _.toNumber(Number.MIN_VALUE);\n * // => 5e-324\n *\n * _.toNumber(Infinity);\n * // => Infinity\n *\n * _.toNumber('3.2');\n * // => 3.2\n */\nfunction toNumber(value) {\n  if (typeof value == 'number') {\n    return value;\n  }\n  if (isSymbol(value)) {\n    return NAN;\n  }\n  if (isObject(value)) {\n    var other = typeof value.valueOf == 'function' ? value.valueOf() : value;\n    value = isObject(other) ? (other + '') : other;\n  }\n  if (typeof value != 'string') {\n    return value === 0 ? value : +value;\n  }\n  value = baseTrim(value);\n  var isBinary = reIsBinary.test(value);\n  return (isBinary || reIsOctal.test(value))\n    ? freeParseInt(value.slice(2), isBinary ? 2 : 8)\n    : (reIsBadHex.test(value) ? NAN : +value);\n}\n\nmodule.exports = toNumber;\n","\"use client\";\nimport { useCallback, useContext, useEffect, useRef } from \"react\";\nimport useSignupWidget from \"@shared/hooks/useSignupWidget\";\nimport { AuthContext } from \"@shared/context/auth.context\";\nimport { useTranslations } from \"next-intl\";\nimport { usePathname } from \"next/navigation\";\n\nconst MAX_EXECUTIONS = 3;\n\nconst LaunchAutoSingUp = () => {\n  const t = useTranslations(\"\");\n  const { isAuthenticated } = useContext(AuthContext);\n  const { openFromPopup } = useSignupWidget({ t });\n  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);\n  const prevOpenRef = useRef<boolean>(false);\n  const pathname = usePathname();\n\n  //* Switched to callback\n  const isSignUpWidgetActive = useCallback(() => {\n    const signUpWidget = document.getElementById(\"sign-up\");\n    if (signUpWidget) {\n      const isActive = signUpWidget.getAttribute(\"open\") === \"true\";\n      return isActive;\n    }\n  }, []);\n\n  const getElapsedSeconds = useCallback((startTime: number) => {\n    const currentTime = Date.now();\n    return Math.floor((currentTime - startTime) / 1000);\n  }, []);\n\n  const startTimer = useCallback(() => {\n    if (isAuthenticated) return;\n\n    let startTime = Number(sessionStorage.getItem(\"timeStart\"));\n    if (!startTime) {\n      startTime = Date.now();\n      sessionStorage.setItem(\"timeStart\", startTime.toString());\n    }\n\n    if (intervalRef.current) {\n      clearInterval(intervalRef.current);\n    }\n\n    intervalRef.current = setInterval(() => {\n      const elapsedSeconds = getElapsedSeconds(startTime);\n\n      const active = !!isSignUpWidgetActive();\n\n      if (prevOpenRef.current && !active) {\n        sessionStorage.removeItem(\"signup_source\");\n      }\n      prevOpenRef.current = active;\n\n      if (elapsedSeconds > MAX_EXECUTIONS * 60) {\n        if (!active) {\n          if (intervalRef.current) {\n            clearInterval(intervalRef.current);\n          }\n          return;\n        }\n      }\n\n      if (elapsedSeconds % 60 === 0) {\n        if (!active) openFromPopup(new Event(\"click\"));\n      }\n    }, 1000);\n  }, [isAuthenticated, getElapsedSeconds, openFromPopup, isSignUpWidgetActive]);\n\n  useEffect(() => {\n    startTimer();\n\n    return () => {\n      if (intervalRef.current) {\n        clearInterval(intervalRef.current);\n      }\n    };\n  }, [startTimer]);\n\n  useEffect(() => {\n    sessionStorage.removeItem(\"signup_source\");\n    prevOpenRef.current = false;\n  }, [pathname]);\n\n  useEffect(() => {\n    const cleanup = () => {\n      sessionStorage.removeItem(\"signup_source\");\n    };\n    window.addEventListener(\"beforeunload\", cleanup);\n    window.addEventListener(\"pagehide\", cleanup);\n    return () => {\n      window.removeEventListener(\"beforeunload\", cleanup);\n      window.removeEventListener(\"pagehide\", cleanup);\n    };\n  }, []);\n\n  useEffect(() => {\n    if (typeof window === \"undefined\") return;\n    const hash = window.location.hash;\n\n    if (hash.startsWith(\"#signin\") && !isAuthenticated) {\n      openFromPopup(new Event(\"click\"));\n      history.replaceState(null, \"\", window.location.pathname + window.location.search);\n    }\n  }, [isAuthenticated, openFromPopup]);\n\n  return null;\n};\n\nexport default LaunchAutoSingUp;\n","import { fullBasePath, loggedUserHost } from \"@magneto-empleos/shared/src/constants/environment.constant\";\n\ntype TOptions = {\n  tag: string;\n  url: string;\n  baseUrl: string;\n  isExternal: boolean;\n};\n\nexport const NORESULTSOPTIONS: TOptions[] = [\n  {\n    tag: \"notFound.menu.nine\",\n    url: \"routes.resume\",\n    baseUrl: `${loggedUserHost}`,\n    isExternal: false\n  },\n  {\n    tag: \"notFound.menu.fifth\",\n    url: \"routes.byCity\",\n    baseUrl: `${fullBasePath}`,\n    isExternal: false\n  },\n  {\n    tag: \"notFound.menu.ten\",\n    url: \"routes.bySector\",\n    baseUrl: `${fullBasePath}`,\n    isExternal: false\n  },\n  {\n    tag: \"notFound.menu.fourth\",\n    url: \"routes.byCompany\",\n    baseUrl: `${fullBasePath}`,\n    isExternal: false\n  }\n];\n","import { useCallback, useContext, useMemo } from \"react\";\nimport { JobsContext } from \"@shared/context/jobs.context\";\nimport { NORESULTSOPTIONS } from \"@schemas/noResults/noResultsOptions.schema\";\nimport { fillUrlUtms } from \"@shared/utils/url/fillUrlUtms.util\";\nimport { isNonEmptyArray } from \"ramda-adjunct\";\nimport { TFunction } from \"@shared/types/locales\";\nimport { getImagePath } from \"@shared/utils/assets/getAsset.util\";\nimport { ASSETS_IMAGES } from \"@shared/constants/assets.constant\";\nimport { useSearchParams } from \"next/navigation\";\n\ntype TProps = {\n  t: TFunction;\n  isAuthenticated: boolean;\n};\n\nconst useMagnetoEmptyResults = ({ t, isAuthenticated }: TProps) => {\n  const context = useContext(JobsContext);\n  const querySearch = useSearchParams();\n\n  const filtersApplied = context.filtersApplied.filters;\n  const activeFilter = useCallback(() => {\n    for (const filter in filtersApplied) {\n      if (isNonEmptyArray(filtersApplied[filter])) {\n        return filter;\n      }\n    }\n  }, [filtersApplied]);\n\n  const titleNoResults = t<string>(\n    `jobOffers.${`noResultsWithSession.${activeFilter() ? \"titleNoResultFilter\" : \"titleNoResultQuery\"}`}`,\n    { searchTerm: querySearch }\n  );\n\n  const noResultsDescription = t<string>(`jobOffers.${\"noResultsWithSession.noResultsDescription\"}`);\n\n  const noResultsDescriptionTwo = t<string>(`jobOffers.noResultsWithSession.noResultsDescriptionTwo`);\n  const filteredOptions = isAuthenticated ? NORESULTSOPTIONS : NORESULTSOPTIONS.slice(1);\n\n  const emptyResultsProps = useMemo(() => {\n    return {\n      titleNoResults,\n      noResultsDescriptionTwo,\n      noResultsDescription,\n      noResultsImage: getImagePath(ASSETS_IMAGES.EMPTY_RESULT),\n      filteredOptions: filteredOptions.map(({ tag, url, baseUrl, isExternal }) => ({\n        tag: t(tag),\n        url: isExternal ? fillUrlUtms(url, querySearch) : fillUrlUtms(`${baseUrl}${t<string>(url)}`, querySearch)\n      }))\n    };\n  }, [filteredOptions, titleNoResults, noResultsDescription, noResultsDescriptionTwo, t, querySearch]);\n\n  return { emptyResultsProps };\n};\nexport default useMagnetoEmptyResults;\n","import { JobsContext } from \"@shared/context/jobs.context\";\nimport { EDeviceTypes } from \"@shared/enums/filter.core.enum\";\nimport { useContext, useEffect, useState } from \"react\";\n\nexport function useValueByDevice<M, D>(mobileValue: M, desktopValue: D): M | D {\n  const [value, setValue] = useState<M | D>(mobileValue);\n  const { device } = useContext(JobsContext);\n\n  useEffect(() => {\n    if (device === EDeviceTypes.desktop) setValue(desktopValue);\n  }, [device, desktopValue]);\n\n  return value;\n}\n","export const formatNumber = (num: number) => new Intl.NumberFormat().format(num);\n","import { language } from \"@magneto-empleos/shared/src/constants/environment.constant\";\n\ntype returnProps = {\n  month: string;\n  year: number;\n  day: number;\n};\n\nexport const getCurrentDayMonthAndYear = (): returnProps => {\n  const date = new Date();\n  const day = date.getDate();\n  const month = date.toLocaleString(language, { month: \"long\" });\n  const year = date.getFullYear();\n  return { day, month, year };\n};\n","import React, { useCallback, useContext, useEffect, useMemo, useState } from \"react\";\nimport { IFilter, IPaginationProps, ISideFilter, ISortBar } from \"magneto365.ui\";\nimport { useValueByDevice } from \"@hooks/useValueByDevice\";\nimport { ESortTypes } from \"@shared/enums/filter.core.enum\";\nimport { formatNumber } from \"@utils/common/formatNumbers.util\";\nimport { getLocaleCountry } from \"@utils/jobOffers/getLocaleCountry.util\";\nimport { capitalize } from \"@shared/utils/strings/capitalize.util\";\nimport { getCurrentDayMonthAndYear } from \"@utils/dates/getCurrentDayMonthAndYear.util\";\nimport { SearchHitContext } from \"@context/searchHit.context\";\nimport { LandingContext } from \"@context/landing.context\";\n\nimport { TFunction } from \"@shared/types/locales\";\nimport { useFilter } from \"@hooks/useFilter\";\nimport { useSearchParams } from \"next/navigation\";\nimport { JobsContext } from \"@shared/context/jobs.context\";\n\ntype