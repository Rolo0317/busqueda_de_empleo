  [normalizeItems.transactionId]: miscOptions?.applicationId,\n      coupon: \"\",\n      [normalizeItems.paymentType]: \"\",\n      segment: miscOptions?.segment\n    }),\n    ...(event === EEventsGA4.viewItemList && {\n      [normalizeItems.itemListName]: listName,\n      [normalizeItems.itemListId]: itemListId(listName),\n      [normalizeItems.algorithmVersion]: miscOptions?.algorithmVersion,\n      [normalizeItems.numberRetrievedResults]: miscOptions?.numberRetrievedResults,\n      [normalizeItems.searchId]: miscOptions?.searchId\n    }),\n    ...(event === EEventsGA4.selectItem && {\n      position: miscOptions?.position,\n      [normalizeItems.vacantId]: miscOptions?.vacantId,\n      [normalizeItems.searchId]: miscOptions?.searchId\n    }),\n    ...(event !== EEventsGA4.purchase && { section: section }),\n    ecommerce: {\n      items: [...items],\n      ...(event === EEventsGA4.beginCheckout && {\n        currency: \"COP\",\n        value: items[0]?.price || 0,\n        questions: miscOptions?.hasQuestions ? \"SI\" : \"NO\"\n      })\n    }\n  };\n};\n\nexport const jsonAuthDataLayer = (userId: number) => {\n  if (!userId) return;\n  return {\n    event: \"authentication\",\n    userId: userId\n  };\n};\n","import { EViewItemListRoutes, EViewItemListSections } from \"@shared/enums/googleAnalyticsV4.enum\";\nimport { extractRouteFromRouter } from \"../url/extractRouteFromRouter.util\";\nimport { Params } from \"next/dist/server/request/params\";\n\nexport const viewItemListSectionFromRoute = (\n  query: Params,\n  querySearch: string | string[] | null | undefined,\n  pathname: string,\n  selectedJob?: boolean\n) => {\n  const cleanRoute = extractRouteFromRouter(pathname);\n\n  if (cleanRoute === EViewItemListRoutes.empleos) {\n    if (selectedJob && !query.jobSlug) {\n      return EViewItemListSections.vacante;\n    }\n    if (selectedJob && query.jobSlug) {\n      return EViewItemListSections.vacantePage;\n    }\n    return EViewItemListSections.vitrinaSearch;\n  }\n\n  if (cleanRoute === EViewItemListRoutes.empresas) {\n    if (selectedJob && !query.jobSlug) {\n      return EViewItemListSections.jobsiteVacante.replace(\"{company_name}\", query.companySlug as string);\n    }\n    if (selectedJob && query.jobSlug) {\n      return EViewItemListSections.jobsiteVacantePage.replace(\"{company_name}\", query.companySlug as string);\n    }\n    if (querySearch) {\n      return EViewItemListSections.jobsiteVitrinaSearch.replace(\"{company_name}\", query.companySlug as string);\n    }\n    if (pathname.includes(EViewItemListRoutes.empleos)) {\n      return EViewItemListSections.jobsiteVitrinaCategory.replace(\"{company_name}\", query.companySlug as string);\n    }\n\n    return EViewItemListSections.jobsiteHome.replace(\"{company_name}\", query.companySlug as string);\n  }\n\n  if (cleanRoute === EViewItemListRoutes.trabajos) {\n    return EViewItemListSections.vitrinaCategory;\n  }\n\n  return \"\";\n};\n","\"use client\";\n\nimport React, { useContext, useMemo } from \"react\";\nimport { message } from \"antd\";\nimport { isNonEmptyArray } from \"ramda-adjunct\";\nimport {\n  TCounterResponse,\n  TFilter,\n  TGlobalFilterSettings,\n  TRequestFilter,\n  TRequestSearch\n} from \"@shared/types/filter.core\";\nimport { ApplicationsSingleton } from \"@shared/classes/applicationsSingleton.class\";\nimport { TJobQuestions, TSendAnswers, TSourceOrigins } from \"@shared/types/detail\";\nimport { TJobRecord, TOffersSuggested, TSimilarVacancies } from \"@shared/types/jobs\";\nimport { JobsContext } from \"@shared/context/jobs.context\";\nimport { AuthContext } from \"@shared/context/auth.context\";\nimport { LandingContext } from \"@shared/context/landing.context\";\nimport { getQueyParams } from \"@shared/utils/url/getQueyParams.util\";\nimport { fMagnetoAdapter, isPublicJobsiteAdapter } from \"@shared/utils/adapters/sourceOrigins.adapter\";\nimport { EEventsGA4, EViewItemListName } from \"@shared/enums/googleAnalyticsV4.enum\";\nimport