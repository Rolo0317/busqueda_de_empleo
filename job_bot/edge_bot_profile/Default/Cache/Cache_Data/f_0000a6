\n  transformer: basicTransformer(\"-\")\n});\nFILTERS_TRANSFORMER_SCHEMA.add({\n  group: \"paginator\",\n  transformer: paginatorTransformer\n});\n","import { TFilterTransformer } from \"@shared/types/filter.core\";\nimport { isEmpty } from \"lodash\";\n\nexport const orderTransformer: TFilterTransformer = async ({ order }) => {\n  const { order: sort, slugifyLabel } = order;\n  if (isEmpty(slugifyLabel)) return \"\";\n\n  const queryString = new URLSearchParams({\n    order: `${sort.toLowerCase()}_${slugifyLabel}`\n  });\n  return `?${queryString}`;\n};\n","import { TGlobalFilterSettings, TRequestSearch } from \"@shared/types/filter.core\";\nimport { FILTERS_TRANSFORMER_SCHEMA } from \"@shared/schemas/filters/transformers.schema\";\nimport { isNotEmpty } from \"ramda\";\nimport { orderTransformer } from \"../filters/transformers/orderTransformer\";\nimport SeoRepository from \"@shared/repositories/seo.repository\";\nimport { isEmpty } from \"lodash\";\n\nconst SEARCH_ROUTE_SEGMENT = \"/trabajos/buscar\";\nconst WORKS_SEGMENT = \"trabajos\";\nconst COMPANIES_SEGMENT = \"empresas\";\nconst COMPANY_JOBS_SEGMENT = \"empleos\";\n\nconst normalizeBasePath = (path: string): string => path.replace(/\\/+$/, \"\") || \"/\";\n\nconst getCompanyJobsBasePath = (pathname: string): string | null => {\n  const segments = pathname.split(\"/\").filter(Boolean);\n  const companyIndex = segments.indexOf(COMPANIES_SEGMENT);\n  const jobsIndex = segments.indexOf(COMPANY_JOBS_SEGMENT);\n\n  if (companyIndex === -1 || jobsIndex === -1) return null;\n  if (jobsIndex !== companyIndex + 2) return null;\n\n  return `/${segments.slice(0, jobsIndex + 1).join(\"/\")}`;\n};\n\nconst getSearchBasePath = (pathname: string): string => {\n  const companyJobsBasePath = getCompanyJobsBasePath(pathname);\n  if (companyJobsBasePath) return normalizeBasePath(companyJobsBasePath);\n\n  const index = pathname.indexOf(SEARCH_ROUTE_SEGMENT);\n  if (index !== -1) return normalizeBasePath(pathname.slice(0, index + SEARCH_ROUTE_SEGMENT.length));\n\n  const segments = pathname.split(\"/\").filter(Boolean);\n  const worksIndex = segments.indexOf(WORKS_SEGMENT);\n  if (worksIndex === -1) return normalizeBasePath(pathname);\n\n  const nextSegment = segments[worksIndex + 1];\n  if (!nextSegment) return normalizeBasePath(pathname);\n\n  return `/${segments.slice(0, worksIndex + 2).join(\"/\")}`;\n};\n\nconst getSearchParamsString = (search: string): string => (search.startsWith(\"?\") ? search.slice(1) : \"\");\n\nconst matchesPath = (basePath: string, segment: string): boolean =>\n  basePath.includes(`/${segment}`) || basePath.includes(`-${segment}`) || basePath.includes(segment);\n\nconst shouldSkipSegment = (segment: string, basePath: string, isSearchBase: boolean): boolean => {\n  if (!segment) return true;\n  if (matchesPath(basePath, segment)) return true;\n  if (!segment.startsWith(\"loc-\")) return false;\n  if (!isSearchBase) return true;\n\n  const locationSlug = segment.slice(4);\n  if (!locationSlug) return true;\n  return matchesPath(basePath, locationSlug);\n};\n\nconst buildUrlSegments = (segments: string[], basePath: string, isSearchBase: boolean): string[] =>\n  segments.filter(isNotEmpty).filter((segment) => !shouldSkipSegment(segment, basePath, isSearchBase));\n\nexport const stateToQueryParams = async (appliedFilters: TRequestSearch, { filters }: TGlobalFilterSettings) => {\n  const { origin, pathname, search } = window.location;\n  const basePath = getSearchBasePath(pathname);\n  const normalizedBasePath = normalizeBasePath(basePath);\n  const isCompanyJobsBase = Boolean(getCompanyJobsBasePath(pathname));\n  const isSearchBase = normalizedBasePath.includes(SEARCH_ROUTE_SEGMENT);\n  const domain = `${origin}${basePath}`;\n  const params = getSearchParamsString(search);\n  const transaction: Promise<string>[] = [];\n\n  for (const { keys, transformer } of FILTERS_TRANSFORMER_SCHEMA) {\n    transaction.push(transformer(appliedFilters, keys, filters));\n  }\n  