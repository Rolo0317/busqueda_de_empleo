Config: TApiConfig = {\n  host: process.env.NEXT_PUBLIC_SEO_API_HOST!,\n  internalHost: process.env.SEO_API_INTERNAL_HOST || process.env.NEXT_PUBLIC_SEO_API_HOST!,\n  endpoints: {\n    megaMenu: {\n      byType: \"/v1/mega-menu/{type}\",\n      searchOccupations: \"/v1/mega-menu/by-occupation/{term}\",\n      byOccupationCategory: \"/v1/mega-menu/by-occupation/{parentSlug}\",\n      byLocationIdsQuery: \"/v1/mega-menu/by-location/by-ids-query\"\n    },\n    landing: {\n      slugBySectorId: \"/v1/landing/slug/{sectorId}\",\n      byType: \"/v1/landing/list/{type}\",\n      bySlug: \"/v1/landing/{slug}\",\n      bySlugOcupacol: \"v1/landing/list/by-occupation-with-location/{parentSlug}\",\n      store: \"/v1/frequent-landings/store\",\n      frequent: \"/v1/frequent-landings/visited/{country}\",\n      frequentBySlug: \"/v1/frequent-landings\"\n    },\n    tests: {\n      bySlug: \"/v1/tests/{slug}\",\n      frequent: \"/v1/frequent-landings/visited\",\n      frequentBySlug: \"v1/frequent-landings\",\n      tags: \"/v1/frequent-landings/tags\",\n      tagsBySector: \"/v1/frequent-landings/tags/sector\",\n      tagsByFilters: \"/v1/frequent-landings/tags/filters\",\n      tagsByQuery: \"/v1/frequent-landings/tags/query\"\n    },\n    faqs: {\n      bySlug: \"/v1/faqs/by-slug/{slug}\",\n      bySearchKey: \"/v1/faqs/by-search-key/{id}\",\n      byQuestionSlug: \"/v1/faqs/{questionSlug}\",\n      store: \"/v1/faqs/store\",\n      tagsByQuery: \"/v1/frequent-landings/tags/query\",\n      allSectors: \"/v1/faqs/by_sector\",\n      tagsByFilters: \"/v1/frequent-landings/tags/filters\"\n    }\n  }\n};\n","type CacheEntry<T> = { data: T; expiry: number };\nexport class ExpiringCache<K, V> {\n  private cache = new Map<K, CacheEntry<V>>();\n  constructor(private expiryMs: number) {}\n\n  get(key: K): V | undefined {\n    const entry = this.cache.get(key);\n    if (entry && entry.expiry > Date.now()) {\n      return entry.data;\n    }\n    this.cache.delete(key);\n    return undefined;\n  }\n\n  set(key: K, value: V) {\n    this.cache.set(key, { data: value, expiry: Date.now() + this.expiryMs });\n  }\n}\n\nexport async function cacheAsync<K, V>(cache: ExpiringCache<K, V>, key: K, request: () => Promise<V>): Promise<V> {\n  const cached = cache.get(key);\n  if (cached !== undefined) return cached;\n  const value = await request();\n  cache.set(key, value);\n  return value;\n}\n\nclass CacheManager {\n  private caches = new Map<string, unknown>();\n\n  public getCache<K, V>(name: string, expiryMs: number): ExpiringCache<K, V> {\n    if (!this.caches.has(name)) {\n      this.caches.set(name, new ExpiringCache<K, V>(expiryMs));\n    }\n    return this.caches.get(name) as ExpiringCache<K, V>;\n  }\n}\n\nexport const cacheManager = new CacheManager();\n","import { TMegaMenuCard, TSlugBySectorIdSchema } from \"@shared/types/megaMenu\";\nimport { seoApiConfig } from \"@shared/config/api/seoMenu.config\";\nimport { ELandingType } from \"@shared/enums/searchHit.enum\";\nimport { ISearchProvider } from \"@shared/interfaces/searchProvider.interface\";\nimport { cacheRequestTime, defaultCountryId, isClientSide, mainBasePath } from \"@shared/constants/environment.constant\";\nimport { cacheAsync, ExpiringCache } from \"@shared/utils/requests/cacheEntries.util\";\nimport { TFrequentLandings, TTagsField, TTagsResponse } from \"@shared/types/landing\";\nimport { FetchClient } from \"@shared/core/fetch.core\";\nimport { TTests } from \"@shared/types/test\";\nimport { TFaqs } from \"@shared/types/faqs\";\n\nconst slugBySectorIdCache = new ExpiringCache<number, TSlugBySectorIdSchema>(cacheRequestTime);\nconst isColombia = defaultCountryId == \"47\";\n\nexport class SeoRepository extends FetchClient implements ISearchProvider {\n  protected abortController?: AbortController;\n\n  constructor() {\n    super(isClientSide ? seoApiConfig.host : seoApiConfig.internalHost!);\n  }\n\n  async getJobsByType(type: ELandingType, countryCode?: string): Promise<TMegaMenuCard[]> {\n    const response = await this.get<TMegaMenuCard[]>(seoApiConfig.endpoints.megaMenu.byType, {\n      params: { type, [\"country_code\"]: countryCode },\n      cache: \"force-cache\",\n      next: { revalidate: 60 * 60 * 24 },\n      rawResponse: false\n    }).catch(() => {\n      return [];\n    });\n    return response;\n  }\n\n  async getJobsByLocationIds(ids: string[]): Promise<TMegaMenuCard[]> {\n    const response = await this.get<TMegaMenuCard[]>(seoApiConfig.endpoints.megaMenu.byLocationIdsQuery, {\n      params: { ids },\n      rawResponse: false\n    });\n    return response;\n  }\n\n  async searchByTerm({ term }: { [key: string]: unknown }) {\n    if (this.abortController && isClientSide) this.abortController.abort();\n    this.abortController = new AbortController();\n    const jobs = await this.get<TMegaMenuCard[]>(seoApiConfig.endpoints.megaMenu.searchOccupations, {\n      params: { term: term as string },\n      signal: this.abortController?.signal,\n      rawResponse: false\n    }).finally(() => {\n      this.abortController = undefined;\n    });\n    return jobs.map(({ h1, slug }) => ({ title: h1, url: slug }));\n  }\n\n  async getSlugBySectorId(sectorId: number, useCache = true): Promise<TSlugBySectorIdSchema> {\n    const request = async () => {\n      try {\n        const slug = await this.get<TSlugBySectorIdSchema>(seoApiConfig.endpoints.landing.slugBySectorId, {\n          params: { sectorId },\n          rawResponse: false\n        });\n        return slug;\n      } catch {\n        return { id: \"\", slug: \"\", h1: \"\" };\n      }\n    };\n    return useCache ? cacheAsync(slugBySectorIdCache, sectorId, request) : request();\n  }\n\n  async saveLanding(params: { slug: string; filters: string }) {\n    await this.post(seoApiConfig.endpoints.landing.store, params);\n    return;\n  }\n\n  async getFrequentLandings() {\n    const frequentLandings = await this.get<TFrequentLandings[]>(seoApiConfig.endpoints.landing.frequent, {\n      params: { country: mainBasePath.replace(\"/\", \"\") },\n      rawResponse: false\n    });\n    return frequentLandings;\n  }\n\n  async getFrequentLanding(slug: string) {\n    const encodeUrl = new URLSearchParams({ slug });\n    const frequentLandings = await this.get<TFrequentLandings>(\n      `${seoApiConfig.endpoints.landing.frequentBySlug}?${encodeUrl}`,\n      { cache: \"force-cache\", next: { revalidate: 60 * 60 * 24 }, rawResponse: false }\n    );\n    return frequentLandings;\n  }\n\n  async getTestBySlug(slug: string) {\n    const testBySlug = await this.get<TTests>(seoApiConfig.endpoints.tests.bySlug, {\n      params: { slug },\n      rawResponse: false\n    });\n    return testBySlug;\n  }\n\n  async getTags(sector?: string) {\n    if (!isColombia) return { tags: [], type: \"\" };\n    const tags = await this.get<TTagsResponse>(seoApiConfig.endpoints.tests.tags, {\n      params: { sector },\n      rawResponse: false\n    });\n    return tags;\n  }\n  async getTagsBySector(params: TTagsField) {\n    const tags = await this.get<TTagsResponse>(seoApiConfig.endpoints.tests.tagsBySector, {\n      params,\n      cache: \"force-cache\",\n      next: { revalidate: 60 * 60 },\n      rawResponse: false\n    });\n\n    return tags;\n  }\n  async getTagsByFilters(params: TTagsField) {\n    const tags = await this.get<TTagsResponse>(seoApiConfig.endpoints.tests.tagsByFilters, {\n      params,\n      cache: \"force-cache\",\n      next: { revalidate: 60 * 60 },\n      rawResponse: false\n    });\n    return tags;\n  }\n  async getQuestionsBySectors() {\n    const questionsBySectors = await this.get<TFaqs[]>(seoApiConfig.endpoints.faqs.allSectors, {\n      cache: \"force-cache\",\n      next: { revalidate: 60 * 60 },\n      rawResponse: false\n    });\n    return questionsBySectors;\n  }\n\n  async getQuestionsBySlug(slug: string) {\n    const questionsBySlug = await this.get<TFaqs[]>(seoApiConfig.endpoints.faqs.bySlug, {\n      params: { slug },\n      rawResponse: fa