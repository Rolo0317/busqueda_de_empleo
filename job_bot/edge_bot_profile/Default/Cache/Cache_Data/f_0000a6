,\n      appliedFilters: contextValue.filtersApplied,\n      applyJobWithAnswer,\n      changeOfferState,\n      setFilters,\n      setLoading,\n      clearFilters,\n      setJobSelected,\n      setJobDetailAction,\n      totalAppliedFilters\n    };\n\n    return <WrappedComponent {...props} {...injectedProps} />;\n  };\n  return WithFilters;\n};\n\nexport default withFiltersHoc;\n","export enum EVacantViews {\n  row = \"row\",\n  listMode = \"listMode\",\n  detailPage = \"detailPage\"\n}\n","import { TFilterTransformer } from \"@shared/types/filter.core\";\nimport { get, isEmpty, isUndefined } from \"lodash\";\nimport { isNotUndefined } from \"ramda-adjunct\";\n\nexport const basicTransformer: (separator?: string) => TFilterTransformer =\n  (separator = \"/\") =>\n  async ({ filters }, keys, options) => {\n    if (isEmpty(filters) || isEmpty(options) || isUndefined(keys)) return \"\";\n    const labels = keys\n      .map((key) => {\n        const values = options?.find((option) => option.field == key)?.values;\n        if (!values) return;\n        const selectedValue = filters[key].at(0);\n        if (!selectedValue) return;\n        const currentValue = values.find((option) => {\n          const id = get(selectedValue, \"id\");\n          if (!id) return option.id == selectedValue;\n          return option.id == id;\n        });\n\n        return currentValue?.slugifyLabel;\n      })\n      .filter(isNotUndefined)\n      .join(separator);\n    return labels;\n  };\n","import { defaultCountryId } from \"@shared/constants/environment.constant\";\nimport JobsRepository from \"@shared/repositories/jobs.repository\";\nimport { TFilterTransformer } from \"@shared/types/filter.core\";\nimport { isEmpty } from \"lodash\";\n\nexport const locationTransformer: TFilterTransformer = async ({ filters, labels }) => {\n  const { locations } = filters;\n  if (isEmpty(locations)) return \"\";\n\n  const location = await JobsRepository.getLocation(\"id\", locations.at(0)?.toString