nst incomingJobSlug = record?.jobSlug ?? null;\n\n      setContextValue((current) => {\n        const currentSelectedId = current.selectedJob?.id ?? null;\n        const incomingSelectedId = record?.id ?? null;\n        const isSameRecord = currentSelectedId === incomingSelectedId;\n\n        if (current.isApplying && !isSameRecord) {\n          return current;\n        }\n        const shouldReleaseLock = current.isApplying && isSameRecord;\n\n        if (incomingJobSlug && !isSameRecord) {\n          shouldLoadSuggestions = true;\n        }\n\n        if (incomingSelectedId !== null && !isSameRecord) {\n          shouldLoadSimilar = true;\n        }\n\n        return {\n          ...current,\n          selectedJob: record,\n          offerSuggested: [],\n          jobQuestions: null,\n          jobDetailAction: null,\n          isApplying: shouldReleaseLock ? false : record ? current.isApplying : false\n        };\n      });\n\n      if (shouldLoadSuggestions && incomingJobSlug)\n        void setOfferSuggested(incomingJobSlug).then((offersSuggested) => {\n          if (isNonEmptyArray(offersSuggested))\n            tagManagerRepository.viewItemList(\n              jsonDataLayer(\n                offersSuggested,\n                EViewItemListName.vacante.replace(\"{company_name}\", record?.companyName as string),\n                viewItemListSectionFromRoute(query, querySearch, pathname, true),\n                EEventsGA4.viewItemList\n              )\n            );\n        });\n      if (shouldLoadSimilar && record?.id) void setSimilarVacancies(record.id, landingPage?.companyId);\n    };\n\n    const setFilters = async (payload: TRequestSearch) => {\n      setJobSelected(null);\n      setContextValue((current) => ({\n        ...current,\n        filtersApplied: payload,\n        offerSuggested: [],\n        jobQuestions: null,\n        loading: true,\n        isApplying: false,\n        jobDetailAction: null\n      }));\n      try {\n        const searchResponse = await JobsRepositoryInstance.search(payload);\n        const selectedJob = searchResponse.rows.length > 0 ? searchResponse.rows[0] : null;\n        const similarVacancies =\n          (selectedJob && (await JobsRepositoryInstance.getSimilarVacancies(selectedJob.id, landingPage?.companyId))) ||\n          [];\n\n        const offersSuggestedResponse: TOffersSuggested[] =\n          (selectedJob && (await JobsRepositoryInstance.getOffersSuggested(selectedJob.jobSlug))) || [];\n        setContextValue((current) => ({\n          ...current,\n          searchResponse,\n          similarVacancies,\n          selectedJob,\n          offerSuggested: offersSuggestedResponse,\n          loading: false,\n          isApplying: false,\n          jobDetailAction: null\n        }));\n        await stateToQueryParams({ ...payload, ...getAllUtms() }, filterSettings);\n      } catch (error) {\n        setContextValue((current) => ({ ...current, loading: false, isApplying: false }));\n        throw error;\n      }\n    };\n\n    const setLoading = (payload: boolean) => {\n      setContextValue((current) => ({ ...current, loading: payload }));\n    };\n\n    const setOfferSuggested = async (jobSlug: string) => {\n      const offersSuggestedResponse: TOffersSuggested[] = await JobsRepositoryInstance.getOffersSuggested(jobSlug);\n      setContextValue((current) => ({ ...current, offerSuggested: offersSuggestedResponse }));\n      return offersSuggestedResponse;\n    };\n\n    const setSimilarVacancies = async (vacantId: number | null, companyId?: number | null) => {\n      const similarVacancies: TSimilarVacancies[] = await JobsRepositoryInstance.getSimilarVacancies(\n        vacantId,\n        companyId\n      );\n      setContextValue((current) => ({ ...current, similarVacancies }));\n    };\n\n    const setJobDetailAction = async (jobId: number | null) => {\n      if (!jobId) {\n        return setContextValue((current) => ({\n          ...current,\n          jobQuestions: null,\n          jobDetailAction: null,\n          isApplying: false\n        }));\n      }\n\n      const setActionState = () =>\n        setContextValue((current) => ({\n          ...current,\n          jobDetailAction: EQueryAction.apply,\n          isApplying: true\n        }));\n\n      if (!authContext.isAuthenticated) {\n        return setActionState();\n      }\n\n      setActionState();\n\n      const offerHasQuestionnaire = contextValue.selectedJob?.hasPrefilterQuestionnaire;\n\n      if (offerHasQuestionnaire) {\n        const jobQuestions: TJobQuestions = await JobsRepositoryInstance.getJobQuestions(jobId);\n        return setContextValue((current) => ({\n          ...current,\n          jobQuestions,\n          jobDetailAction: EQueryAction.apply,\n          isApplying: true\n        }));\n      }\n\n      if (applicationsSingleton.hasApplication(jobId)) return;\n      applicationsSingleton.addApplication(jobId);\n      const suggestedByMatcher = getSuggestedByMatcher(query);\n      return JobsRepositoryInstance.applyJob({ jobId, suggestedByMatcher, sourceOrigins })\n        .then((applyResponse) => {\n          applicationsSingleton.completeApplication(jobId);\n\n          tagManagerRepository.purchaseV4(\n            jsonDataLayer(\n              [contextValue.selectedJob as TJobRecord],\n              EViewItemListName.generalOffers.replace(\n                \"{query}\",\n                querySearch ? (querySearch as string) : EViewItemListName.enColombia\n              ),\n              viewItemListSectionFromRoute(query, querySearch, pathname, !!contextValue.selectedJob),\n              EEventsGA4.purchase,\n              {\n                applicationId: applyResponse.data.applicationId,\n                segment: String(contextValue.selectedJob?.companySegment)\n              }\n            )\n          );\n          NotificationsRepository.updateNotificationPreferences(ACTIVE_PROCESS_CHANNELS);\n          if (isJobSlugPage) {\n            return JobsRepositoryInstance.getSelectedJob(jobId.toString(), undefined, true).then((selectedJob) => {\n              setContextValue((current) => ({ ...current, selectedJob, isApplying: false, jobDetailAction: null }));\n            });\n          }\n          return setFilters(contextValue.filtersApplied);\n        })\n        .catch((error) => {\n          applicationsSingleton.completeApplication(jobId);\n          setContextValue((current) => ({ ...current, isApplying: false }));\n          throw error;\n        });\n    };\n\n    const applyJobWithAnswer = async (answers: TSendAnswers) => {\n      const suggestedByMatcher = getSuggestedByMatcher(query);\n      JobsRepositoryInstance.applyJob({ ...answers, suggestedByMatcher, sourceOrigins }).then((applyResponse) => {\n        if (isJobSlugPage) {\n          return JobsRepositoryInstance.getSelectedJob(answers.jobId.toString(), undefined, true).then(\n            (selectedJob) => {\n              setContextValue((current) => ({\n                ...current,\n                selectedJob,\n                jobQuestions: null,\n                jobDetailAction: null,\n                isApplying: false\n              }));\n            }\n          );\n        }\n        tagManagerRepository.purchaseV4(\n          jsonDataLayer(\n            [contextValue.selectedJob as TJobRecord],\n            EViewItemListName.generalOffers.replace(\n              \"{query}\",\n              querySearch ? (querySearch as string) : EViewItemListName.enColombia\n            ),\n            viewItemListSectionFromRoute(query, querySearch, pathname, !!contextValue.selectedJob),\n            EEventsGA4.purchase,\n            {\n              applicationId: applyResponse.data.applicationId,\n              segment: String(contextValue.selectedJob?.companySegment)\n            }\n          )\n        );\n        NotificationsRepository.updateNotificationPreferences(ACTIVE_PROCESS_CHANNELS);\n        return setFilters(contextValue.filtersApplied);\n      