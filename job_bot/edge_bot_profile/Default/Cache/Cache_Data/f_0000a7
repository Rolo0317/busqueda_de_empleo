& { rawResponse?: true }\n  ): Promise<FetchResponse<T>>;\n  put<T>(url: string, body: unknown, config: Omit<FetchConfig, \"url\" | \"method\"> & { rawResponse: false }): Promise<T>;\n  put<T>(url: string, body?: unknown, config?: Omit<FetchConfig, \"url\" | \"method\">): Promise<T | FetchResponse<T>> {\n    return this.request<T>({ ...config, url, method: \"PUT\", body }).then((res) =>\n      this.unwrap(res, config?.rawResponse)\n    );\n  }\n\n  patch<T>(\n    url: string,\n    body?: unknown,\n    config?: Omit<FetchConfig, \"url\" | \"method\"> & { rawResponse?: true }\n  ): Promise<FetchResponse<T>>;\n  patch<T>(\n    url: string,\n    body: unknown,\n    config: Omit<FetchConfig, \"url\" | \"method\"> & { rawResponse: false }\n  ): Promise<T>;\n  patch<T>(url: string, body?: unknown, config?: Omit<FetchConfig, \"url\" | \"method\">): Promise<T | FetchResponse<T>> {\n    return this.request<T>({ ...config, url, method: \"PATCH\", body }).then((res) =>\n      this.unwrap(res, config?.rawResponse)\n    );\n  }\n\n  delete<T>(\n    url: string,\n    config?: Omit<FetchConfig, \"url\" | \"method\"> & { rawResponse?: true }\n  ): Promise<FetchResponse<T>>;\n  delete<T>(url: string, config: Omit<FetchConfig, \"url\" | \"method\"> & { rawResponse: false }): Promise<T>;\n  delete<T>(url: string, config?: Omit<FetchConfig, \"url\" | \"method\">): Promise<T | FetchResponse<T>> {\n    return this.request<T>({ ...config, url, method: \"DELETE\" }).then((res) => this.unwrap(res, config?.rawResponse));\n  }\n\n  private async toResponse<T>(response: Response, config: FetchConfig): Promise<FetchResponse<T>> {\n    const headers: Record<string, string> = {};\n    response.headers.forEach((value, key) => {\n      headers[key] = value;\n    });\n\n    const isEmpty = response.status === 204 || response.status === 205;\n    const contentType = response.headers.get(\"content-type\") || \"\";\n    const asJson = contentType.includes(\"application/json\");\n    const data = isEmpty ? null : asJson ? await response.json() : await response.text();\n    const { signal, cancelToken, ...safeConfig } = config;\n    void signal;\n    void cancelToken;\n\n    return {\n      data: data as T,\n      status: response.status,\n      statusText: response.statusText,\n      headers,\n      ok: response.ok,\n      url: response.url,\n      config: safeConfig as FetchMapConfig\n    };\n  }\n\n  private toError<T>(response: FetchResponse<T>): FetchHttpError<T> {\n    const error = new Error(`HTTP error ${response.status}`) as FetchHttpError<T>;\n    error.response = response;\n    return error;\n  }\n}\n","export const getHoursDifferenceBetween = (targetDate: Date, currentDate: Date = new Date()) => {\n  const timeDifference = targetDate.getTime() - currentDate.getTime();\n  if (typeof timeDifference !== \"number\" && typeof timeDifference !== \"bigint\") {\n    throw new Error(\"Invalid time difference\");\n  }\n  return Math.floor((timeDifference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));\n};\n","import { isServerSide } from \"@shared/constants/environment.constant\";\n\nconst getBaseDomain = (): string => {\n  if (isServerSide) return \"\";\n  const hostname = window.location.hostname;\n  const domainParts = hostname.split(\".\");\n  if (domainParts.length > 2) return \".\" + domainParts.slice(-2).join(\".\");\n  else if (domainParts.length === 2) return \".\" + hostname;\n  return hostname;\n};\n\nexport const updateCookieClientSide = (cookieName: string): string | null => {\n  if (isServerSide) return null;\n  const baseDomain = getBaseDomain();\n  document.cookie = `${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${baseDomain};`;\n  return null;\n};\n","import { initAuthContext } from \"@shared/context/auth.context\";\nimport AuthRepository from \"@shared/repositories/auth.repository\";\nimport { ISession } from \"@shared/types/auth\";\nimport { getHoursDifferenceBetween } from \"../dates/getHoursDifferenceBetween.util\";\nimport { getCookieClientSide } from \"./getCookie.util\";\nimport { getUserFromToken } from \"./getUserFromToken.util\";\nimport { updateCookieClientSide } from \"./updateCookie.util\";\n\nexport const tokenDispatcher = (callBack: (data: ISession) => void) => (token: string | null) => {\n  if (token) {\n    window.localStorage.setItem(\"access_token\", token);\n    callBack({ isAuthenticated: true, user: getUserFromToken(token) });\n  } else {\n    window.localStorage.removeItem(\"access_token\");\n    callBack(initAuthContext);\n  }\n};\n\nexport const refreshTokenDispacher = (callBack: (data: ISession) => void) => (token: string) => {\n  if (token) {\n    AuthRepository.refreshSession().then(callBack);\n  }\n};\n\nexport const challengeDispatcher = (callBack: (data: ISession) => void) => (tokenChallenge: string | null) => {\n  if (tokenChallenge) {\n    AuthRepository.requestSessionByChallenge(tokenChallenge).then(callBack);\n  }\n};\n\nexport const revokeChallengeDispacher = (callBack: (data: ISession) => void) => (tokenChallenge: string) => {\n  AuthRepository.revokeChallenge(tokenChallenge).then(callBack);\n};\n\nexport const logoutDispatcher = () => {\n  updateCookieClientSide(\"access_token\");\n  window.localStorage.removeItem(\"access_token\");\n};\n\nexport const isNearlyToExpire = (): boolean => {\n  const expiresAt = getCookieClientSide(\"expires_at\");\n  if (!expiresAt) return true;\n  const expires = new Date(decodeURIComponent(expiresAt));\n  return getHoursDifferenceBetween(expires) <= 2;\n};\n","export const isClientSide: boolean = typeof window !== \"undefined\";\nexport const isServerSide: boolean = typeof window === \"undefined\";\nexport const fullBasePath: string = process.env.NEXT_PUBLIC_APP_FULL_BASE_PATH || \"\";\nexport const availableCountries: string[] = process.env.NEXT_PUBLIC_AVAILABLE_COUNTRIES!.split(\",\");\nexport const defaultCountryId = process.env.NEXT_PUBLIC_DEFAULT_COUNTRY_FILTER_ID ?? \"\";\nexport const isJobsPage = isClientSide