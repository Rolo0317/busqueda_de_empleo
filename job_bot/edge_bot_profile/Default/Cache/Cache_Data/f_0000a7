aseHost}/notifications.widget.js?ts=${new Date().getTime()}`\n      : \"http://localhost:8082/widget-dist\";\n  })()\n};\nexport const clientHost = process.env.NEXT_PUBLIC_APP_MAIN_DOMAIN || \"http://localhost:8060\";\nexport const availableLanguages: string = \"es-CO\";\nexport const cacheRequestTime: number = 5 * 60 * 1000;\nexport const legacySignUpWidget: boolean = process.env.NEXT_PUBLIC_LEGACY_SIGN_UP_WIDGET === \"true\";\nexport const growthApiUrl: string = process.env.NEXT_PUBLIC_GROWTH_API_URL || \"http://localhost:3456/growth\";\nexport const landingApiToken: string = process.env.NEXT_PUBLIC_LANDING_API_TOKEN || \"\";\n","import { ISubject } from \"../interfaces/subject.interface\";\nimport { IObserver } from \"../interfaces/observer.interface\";\n\nexport class ProfileSubject implements ISubject {\n  public nextAction: string | null;\n  private observers: IObserver[] = [];\n\n  constructor() {\n    this.nextAction = null;\n  }\n\n  public attach(observer: IObserver): void {\n    const isExist = this.observers.includes(observer);\n    if (isExist) return;\n    this.observers.push(observer);\n  }\n\n  public detach(observer: IObserver): void {\n    const observerIndex = this.observers.indexOf(observer);\n    if (observerIndex === -1) return;\n    this.observers.splice(observerIndex, 1);\n  }\n\n  public notify(): void {\n    for (const observer of this.observers) {\n      observer.update(this);\n    }\n  }\n\n  public updateAction(nextAction: string | null): void {\n    if (this.nextAction === nextAction) return;\n    this.nextAction = nextAction;\n    this.notify();\n  }\n}\n\nconst ProfileSubjectInstance = new ProfileSubject();\nexport default ProfileSubjectInstance;\n","\"use client\";\nimport { ProfileConcreteObserver } from \"@shared/classes/profileConcreteObserver.class\";\nimport ProfileSubject from \"@shared/classes/profileSubject.class\";\nimport CandidateRepositoryInstance from \"@shared/repositories/candidate.repository\";\nimport JobsRepositoryInstance from \"@shared/repositories/jobs.repository\";\nimport { TCandidateCtx } from \"@shared/types/candidate\";\nimport { isAvailableToApply } from \"@shared/utils/candidate/isAvailableToApply.util\";\nimport { createContext, useCallback, useContext, useEffect, useMemo, useState } from \"react\";\nimport { AuthContext } from \"./auth.context\";\n\nexport const initCandidateContext: TCandidateCtx = {\n  candidate: null,\n  originsAndLinkups: null,\n  availableToApply: false,\n  candidateApplications: null,\n  termsAccepted: null\n};\n\nexport const CandidateContext = createContext<TCandidateCtx>(initCandidateContext);\n\nexport const CandidateProvider = ({ children }: { children: React.ReactNode }) => {\n  const authContext = useContext(AuthContext);\n  const [candidateContext, setCandidateContext] = useState<TCandidateCtx>(initCandidateContext);\n\n  const callbackProfileComplete = useCallback((subject: typeof ProfileSubject) => {\n    if (!subject.nextAction) return;\n\n    CandidateRepositoryInstance.getProfile().then((candidate) => {\n      if (candidate) {\n        CandidateRepositoryInstance.checkTerms().then((termsAccepted) => {\n          JobsRepositoryInstance.getOriginsAndLinkups().then((originsAndLinkups) => {\n            setCandidateContext({\n              candidate,\n              originsAndLinkups,\n              availableToApply: isAvailableToApply(candidate),\n              termsAccepted\n            });\n          });\n        });\n      }\n    });\n  }, []);\n\n  const profileObserver = useMemo(() => {\n    return new ProfileConcreteObserver(callbackProfileComplete);\n  }, [callbackProfileComplete]);\n\n  useEffect(() => {\n    if (!authContext.isAuthenticated) return setCandidateContext(initCandidateContext);\n    CandidateRepositoryInstance.getProfile().then((candidate) => {\n      CandidateRepositoryInstance.checkTerms().then((termsAccepted) => {\n        JobsRepositoryInstance.getOriginsAndLinkups().then((originsAndLinkups) => {\n          setCandidateContext({\n            candidate,\n            originsAndLinkups,\n            availableToApply: isAvailableToApply(candidate),\n            termsAccepted\n          });\n        });\n      });\n    });\n  }, [authContext.isAuthenticated, profileObserver]);\n\n  useEffect(() => {\n    ProfileSubject.attach(profileObserver);\n    return () => {\n      ProfileSubject.detach(profileObserver);\n    };\n  }, [profileObserver]);\n\n  return <CandidateContext.Provider value={candidateContext}>{children}</CandidateContext.Provider>;\n};\n\nCandidateContext.displayName = \"CandidateContext\";\n","import { FetchCancelToken } from \"@shared/classes/fetchCancelToken.class\";\nimport { jobsApiConfig } from \"@shared/config/api/jobs.config\";\nimport { availableLanguages, isClientSide } from \"@shared/constants/environment.constant\";\nimport { FetchClient } from \"@shared/core/fetch.core\";\nimport { EVacantStates } from \"@shared/enums/vacantStates.enum\";\nimport { ISearchProvider } from \"@shared/interfaces/searchProvider.interface\";\nimport { TApplyData } from \"@shared/types/applyResponse\";\nimport { TOriginsLinkups } from \"@shared/types/candidate\";\nimport { TJobQuestions, TSendAnswers } from \"@shared/types/detail\";\nimport { TRequestSearch, TSearchResponse, TSettingsJobSiteSearch } from \"@shared/types/filter.core\";\nimport { TJobRecord, TOffersSuggested, TSettingsJobSite, TSimilarVacancies } from \"@shared/types/jobs\";\nimport { TFunction } from \"@shared/types/locales\";\nimport { TCityByIP } from \"@shared/types/referred\";\nimport { isAuthenticatedUser } from \"@shared/utils/auth/isAuthenticatedUser.util\";\nimport { getAllUtms } from \"@shared/utils/url/getAllUtms.util\";\nimport { omit, prop } from \"ramda\";\n\nexport class JobsRepository extends FetchClient implements ISearchProvider {\n  protected searchToken?: FetchCancelToken;\n\n  constructor() {\n    super(isClientSide? jobsApiConfig.host: jobsApiConfig.internalHost!);\n  }\n\n  async search(nextParams: TRequestSearch): Promise<TSearchResponse<TJobRecord>> {\n    const { isAuthenticated, endpoints } = await this.auth();\n    if (this.searchToken && isClientSide) this.searchToken.cancel(\"ABORTING_PREVIOUS_REQUEST\");\n    const withoutSearch = omit([\"q\"], nextParams);\n    const querySearch = prop(\"q\", nextParams);\n    const params = {\n      ...withoutSearch,\n      queries: querySearch ? [{ field: \"all\", term: querySearch }] : []\n    };\n\n    const cancelToken = new FetchCancelToken();\n    this.searchToken = cancelToken;\n\n    const search = await this.get<TSearchResponse<TJobRecord>>(endpoints.search, {\n      params,\n      withAuth: isAuthenticated,\n      cancelToken\n    });\n    return search.data;\n  }\n  async getSelectedJobBySlug(jobSlug: string, companyShowSlug?: string): Promise<TJobRecord> {\n    return this.get<TJobRecord>(jobsApiConfig.endpoints.jobs.detail, {\n      params: { jobSlug, companyShowSlug },\n      next: { revalidate: 1200 },\n      cache: \"force-cache\"\n    }).then((response) => response.data);\n  }\n\n  async getSelectedJob(id: string, companyShowSlug?: string, withId?: boolean): Promise<TJobRecord> {\n    const { isAuthenticated, endpoints } = await this.auth();\n    const url = isAuthenticated ? (withId ? endpoints.detailById : endpoints.detailBySlug) : endpoints.detail;\n\n    const jobs = await this.get<TJobRecord>(url, {\n      withAuth: isAuthenticated,\n      params: { jobSlug: id, companyShowSlug },\n      cache: \"force-cache\",\n      next: { revalidate: 1200 }\n    });\n    return jobs.data;\n  }\n\n  async getOffersSuggested(jobSlug: string): Promise<TOffersSuggested[]> {\n    const { isAuthenticated, endpoints } = await this.auth();\n    const offers = await this.get<TOffersSuggested[]>(endpoints.suggested, {\n      withAuth: isAuthenticated,\n      params: { jobSlug }\n    });\n    return offers.data;\n  }\n\n  async getSettingsJobSite(params: TSettingsJobSiteSearch): Promise<TSettingsJobSite>