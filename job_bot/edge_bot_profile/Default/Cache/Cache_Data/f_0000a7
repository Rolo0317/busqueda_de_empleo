\"clean\";\n    };\n\nexport function signUpReducer(state: State, action: Action): State {\n  switch (action.type) {\n    case \"init\":\n      return {\n        ...state,\n        vacantId: action.payload.vacantId ?? null,\n        mode: action.payload.mode,\n        shouldLoadCustomElement: true,\n        open: true\n      };\n\n    case \"finish\":\n      return {\n        ...state,\n        vacantId: null,\n        open: false,\n        status: \"FINISHED\"\n      };\n\n    case \"clean\": {\n      return {\n        ...state,\n        vacantId: null,\n        open: false,\n        status: \"IDLE\"\n      };\n    }\n    default:\n      return state;\n  }\n}\n","\"use client\";\nimport { useEffect } from \"react\";\n\n/**\n *\n * @param tagName custom element name.\n * @param elementId id for the custom element.\n * @param onReady function that must be a useCallback to notify the custom element was loaded.\n */\nexport function useCustomElementReady<T extends HTMLElement = HTMLElement>(\n  tagName: string,\n  elementId: string,\n  onReady: (el: T) => void\n) {\n  useEffect(() => {\n    let isCancelled = false;\n\n    customElements.whenDefined(tagName).then(() => {\n      if (isCancelled) return;\n      const element = document.getElementById(elementId) as T | null;\n      if (element) {\n        onReady(element);\n      }\n    });\n\n    return () => {\n      isCancelled = true;\n    };\n  }, [tagName, elementId, onReady]);\n}\n","import Script from \"next/script\";\nimport React, {\n  useCallback,\n  useContext,\n  forwardRef,\n  useRef,\n  useImperativeHandle\n} from \"react\";\nimport { WidgetHost } from \"@shared/constants/environment.constant\";\nimport { SignUpContext } from \"@shared/context/signUp.context\";\nimport { HTMLMagnetoSignUpElement } from \"@shared/types/widget\";\nimport { TAppliedSignUp } from \"@shared/types/apply\";\nimport { useCustomElementReady } from \"@shared/hooks/useCustomElementReady\";\n\n\n\nconst SignUpApply = forwardRef<TAppliedSignUp.Methods, TAppliedSignUp>(\n  (\n    {\n      open,\n      onClose,\n      onFinish,\n      vacantId,\n      mode,\n      shouldLoadCustomElement\n    },\n    ref\n  ) => {\n    const { clean } = useContext(SignUpContext);\n    const webComponentRef = useRef<HTMLMagnetoSignUpElement>(null);\n\n    useImperativeHandle(ref, () => ({\n      update: (payload: Parameters<HTMLMagnetoSignUpElement['update']>[0]) => {\n        if (webComponentRef.current) {\n          customElements.whenDefined(\"magneto-sign-up\").then(() => {\n            webComponentRef.current!.update(payload);\n          });\n        }\n      }\n    }));\n\n    const handleOnFinish = useCallback(() => {\n      onFinish(mode);\n    }, [mode, onFinish]);\n\n    const handleOnClose = useCallback(() => {\n      onClose();\n      clean();\n    }, [clean, onClose]);\n\n    const handleAssignEvents = useCallback(\n      (target: HTMLMagnetoSignUpElement) => {\n        target.onclose = handleOnClose;\n        target.oncompleted = handleOnFinish;\n      },\n      [handleOnClose, handleOnFinish]\n    );\n\n    useCustomElementReady(\"magneto-sign-up\", \"sign-up\", handleAssignEvents);\n    return (\n      <>\n        <magneto-sign-up\n          ref={webComponentRef}\n          id=\"sign-up\"\n          vacant-id={vacantId}\n          mode={mode}\n          open={`${open}`}\n        />\n        {shouldLoadCustomElement ? (\n          <Script\n            src={WidgetHost.signUp}\n            strategy=\"afterInteractive\"\n            onError={() => console.error(\"Error loading the script\")}\n          />\n        ) : null}\n      </>\n    );\n  }\n);\n\nSignUpApply.displayName = \"SignUpApply\";\n\nexport default SignUpApply;\n","\"use client\";\nimport { HTMLMagnetoSignUpElement, TSignUpApplyMode } from \"@shared/types/widget\";\nimport { signUpReducer } from \"@shared/components/signUp/signUp.provider\";\nimport SignUpApply from \"@shared/components/common/signUpApply/component\";\nimport React, { createContext, useCallback, PropsWithChildren, useReducer } from \"react\";\nimport { TAppliedSignUp } from \"@shared/types/apply\";\n\ntype WebComponentProps = {\n  vacantId?: string;\n  mode: TSignUpApplyMode;\n};\n\ninterface SignUpContextType {\n  open: (params: WebComponentProps) => void;\n  clean: () => void;\n  status: \"IDLE\" | \"FINISHED\";\n  mode: TSignUpApplyMode;\n  isReady: () => Promise<boolean>;\n  update: (params: Parameters<HTMLMagnetoSignUpElement['update']>[0]) => void\n}\n\nexport const SignUpContext = createContext<SignUpContextType>({\n  open: () => {\n    return null;\n  },\n  clean: () => {\n    return null;\n  },\n  status: \"IDLE\",\n  mode: \"APPLY_WITH_AUTH\",\n  isReady: () => Promise.resolve(false),\n  update: () => null\n});\n\nexport const initState = {\n  vacantId: null,\n  open: false,\n  status: \"IDLE\" as const,\n  mode: \"APPLY_WITH_AUTH\" as const,\n  shouldLoadCustomElement: false\n};\n\nexport const SignUpProvider = ({ children }: PropsWithChildren) => {\n  const [state, dispatch] = useReducer(signUpReducer, initState);\n  const signupRef = React.useRef<TAppliedSignUp.Methods>(null);\n\n  const open = useCallback(({ vacantId, mode }: WebComponentProps) => {\n    dispatch({\n      type: \"init\",\n      payload: { vacantId, mode }\n    });\n  }, []);\n\n  const clean = useCallback(() => {\n    dispatch({\n      type: \"clean\"\n    });\n  }, []);\n\n  const update = useCallback((payload: Parameters<HTMLMagnetoSignUpElement['update']>[0]) => {\n    signupRef.current?.update(payload);\n  }, []);\n\n  const isReady = useCallback(\n    () =>\n      customElements\n        .whenDefined(\"magneto-sign-up\")\n        .then((val) => (val ? true : false))\n        .catch(() => false),\n    []\n  );\n\n  return (\n    <SignUpContext.Provider value={{ open, clean, status: state.status, mode: state.mode, isReady, update }}>\n      <>\n        <SignUpApply\n          {...state}\n          ref={signupRef}\n          onClose={() => {\n            dispatch({ type: \"clean\" });\n          }}\n          onFinish={() => {\n            dispatch({ type: \"finish\" });\n          }}\n        />\n        {children}\n      </>\n    </SignUpContext.Provider>\n  );\n};\n","import { TUser } from \"@shared/types/auth\";\n\nexport const getUserFromToken = (token: string) => {\n  const [, encodeUser] = token.split(\".\");\n  const user: TUser = JSON.parse(Buffer.from(encodeUser, \"base64\").toString(\"utf-8\"));\n  return user;\n};\n","export const getAllUtms = (): Record<string, string> => {\n  const url = new URL(window.location.href);\n  const params = Array.from(url.searchParams.entries());\n  const utmEntries = params.filter(([key]) => key.startsWith(\"utm_\") || key === \"gclid\");\n  if (!utmEntries.length) return {};\n  return Object.fromEntries(utmEntries);\n};\n","import { isServerSide } from \"../../constants/environment.constant\";\nexport const getTokenChallenge = (): string | null => {\n  if (isServerSide) return null;\n\n  const searchParams = new URLSearchParams(location.search);\n  return searchParams.get(\"challenge\");\n};\n","\"use client\";\n\nimport { AuthContext } from \"@shared/context/auth.context\";\nimport { ISession } from \"@shared/types/auth\";\nimport { getCookieClientSide } from \"@shared/utils/auth/getCookie.util\";\nimport { getTokenChallenge } from \"@shared/utils/auth/getTokenChallenge.util\";\nimport {\n  isNearlyToExpire,\n  revokeChallengeDispacher,\n  refreshTokenDispacher,\n  tokenDispatcher,\n  challengeDispatcher\n} from \"@shared/utils/auth/validators.util\";\nimport { isEqual } from \"lodash\";\nimport React, { useCallback, useContext, useEffect, useLayoutEffect, useRef } from \"react\";\n\nconst AuthListener: React.FC = () => {\n  const intervalRef = useRef<NodeJS.Timer>(null);\n  const context = useContext(AuthContext);\n  const contextRef = useRef<ISession>(context);\n\n  const updateContext = useCallback((data: ISession) => {\n    if (!contextRef.current) return;\n    const { isAuthenticated, user, setContextValue } = contextRef.current;\n    if (!isEqual(isAuthenticated, data.isAuthenticated) || !isEqual(user, data.user))\n      setContextValue({ ...data, setContextValue });\n  }, []);\n\n  const handlerAuthType = useCallback(() => {\n    const token = getCookieClientSide(\"access_token\");\n    const isTokenNearlyToExpire = isNearlyToExpire();\n    const rfKey = getCookieClientSide(\"rfKey\");\n    const challenge = getTokenChallenge();\n    if (token && challenge && rfKey) revokeChallengeDispacher(updateContext)(challenge);\n    if (isTokenNearlyToExpire && rfKey) return refreshTokenDispacher(updateContext)(rfKey);\n    if (token) return tokenDispatcher(updateContext)(token);\n    if (challenge) return challengeDispatcher(updateContext)(challenge);\n    return tokenDispatcher(updateContext)(token);\n  }, [updateContext]);\n\n  useEffect(() => {\n    contextRef.current = context;\n  }, [context]);\n\n  useLayoutEffect(() => {\n    if (intervalRef.current) return;\n    intervalRef.current = setInterval(() => {\n      handlerAuthType();\n    }, 1000);\n  }, [handlerAuthType]);\n\n  return <React.Fragment />;\n};\n\nexport default AuthListener;\n","\"use client\";\nimport { createContext, useState } from \"react\";\nimport { ISession } from \"@shared/types/auth\";\nimport AuthListener from \"@shared/components/auth/listener\";\n\nexport const initAuthContext: ISession = {\n  user: null,\n  isAuthenticated: false,\n  setContextValue: null\n};\n\nexport const AuthContext = createContext<ISession>(initAuthContext);\n\nexport const AuthProvider = ({ children, context }: { children: React.ReactNode; context: ISession }) => {\n  const [currentContext, setContextValue] = useState(context);\n  return (\n    <AuthContext.Provider value={{ ...currentContext, setContextValue }}>\n      <AuthListener />\n      {children}\n    </AuthContext.Provider>\n  );\n};\n\nAuthContext.displayName = \"AuthContext\";\n","export type TFetchCanceler = (message?: string) => void;\n\nexport class FetchCancelToken {\n  private readonly controller: AbortController;\n  readonly signal: AbortSignal;\n\n  constructor(executor?: (cancel: TFetchCanceler) => void) {\n    this.controller = new AbortController();\n    this.signal = this.controller.signal;\n    if (!executor) return;\n    executor((message?: string) => this.cancel(message));\n  }\n\n  cancel(message?: string) {\n    if (this.signal.aborted) return;\n    this.controller.abort(message ? new Error(message) : undefined);\n  }\n\n  static source() {\n    const token = new FetchCancelToken();\n    return { token, cancel: token.cancel.bind(token) };\n  }\n}\n","export const MAX_LENGHT = {\n  inputText: 120,\n  textArea: 2000,\n  shortQuestionArea: 140,\n  longQuestionArea: 2500\n};\n","/* eslint-disable @typescript-eslint/no-explicit-any */\n\nimport { candidateApiConfig } from \"@shared/config/api/candidate.config\";\nimport { FetchClient } from \"@shared/core/fetch.core\";\nimport { TCandidate, TCandidateApplications } from \"@shared/types/candidate\";\n\nclass CandidateRepository extends FetchClient {\n  constructor() {\n    super(candidateApiConfig.host);\n  }\n\n  async getProfile(): Promise<TCandidate> {\n    return this.get<TCandidate>(candidateApiConfig.endpoints.candidate.profile, { withAuth: true }).then(\n      (response) => response.data\n    );\n  }\n\n  async getCandidateApplicationCount(): Promise<TCandidateApplications> {\n    return this.get<TCandidateApplications>(candidateApiConfig.endpoints.candidate.applicationsCount, {\n      withAuth: true\n    }).then((response) => response.data);\n  }\n\n  async checkTerms(): Promise<boolean> {\n    return this.get<boolean>(candidateApiConfig.endpoints.candidate.verify, { withAuth: true }).then(\n      (response) => response.data\n    );\n  }\n\n  async acceptTerms() {\n    return this.post(candidateApiConfig.endpoints.candidate.acceptTerms);\n  }\n\n  async verifyEmail(email: string): Promise<boolean> {\n    try {\n      await this.post(candidateApiConfig.endpoints.register.verifyEmail, { email });\n      return true;\n    } catch {\n      return false;\n    }\n  }\n\n  async verifyEmailAndPhone(email: string, phone: string): Promise<boolean> {\n    try {\n      const response = await this.post(candidateApiConfig.endpoints.register.verifyEmailAndPhone, { email, phone });\n      return typeof response.data === \"boolean\" ? response.data : false;\n    } catch {\n      return false;\n    }\n  }\n\n  async registerAccount(data: Record<string, any>): Promise<Record<string, any>> {\n    return this.post<Record<string, any>>(candidateApiConfig.endpoints.register.registerAccount, data).then(\n      (response) => (response.status === 200 ? response.data : {})\n    );\n  }\n  async parserUpload(file: File) {\n    const formData = new FormData();\n    formData.append(\"file\", file, file.name);\n    return this.post(candidateApiConfig.endpoints.candidate.parser, formData, {\n      headers: { \"Content-Type\": \"multipart/form-data\" },\n      withAuth: true\n    }).then((response) => response);\n  }\n}\n\nconst CandidateRepositoryInstance = new CandidateRepository();\nexport default CandidateRepositoryInstance;\n","import { FetchCancelToken } from \"@shared/classes/fetchCancelToken.class\";\n\nexport type FetchConfig = Omit<RequestInit, \"body\" | \"signal\"> & {\n  url: string;\n  params?: Record<string, unknown>;\n  withAuth?: boolean;\n  cancelToken?: FetchCancelToken;\n  /** Timeout in milliseconds */\n  timeout?: number;\n  signal?: AbortSignal;\n  body?: unknown;\n  /** Default: true returns the full object(data, statusCode, etc), false to get data only */\n  rawResponse?: boolean;\n};\n\nexport type FetchMapConfig = Omit<FetchConfig, \"signal\" | \"cancelToken\">;\n\nexport type FetchResponse<T> = {\n  data: T;\n  status: number;\n  statusText: string;\n  headers: Record<string, string>;\n  ok: boolean;\n  url: string;\n  config: FetchMapConfig;\n};\n\nexport type FetchHttpError<T = unknown> = Error & { response: FetchResponse<T> };\nexport const EMPTY_HEADERS: HeadersInit = {};\n","import { isClientSide } from \"@shared/constants/environment.constant\";\n\nexport const clearInvalidSessionCookies = (): void => {\n  if (!isClientSide) return;\n  const cookiesToClear = [\"access_token\", \"rfKey\", \"expires_at\", \"challenge\"];\n  cookiesToClear.forEach((cookieName) => {\n    document.cookie = `${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;\n    const domain = window.location.hostname.split(\".\").slice(-2).join(\".\");\n    document.cookie = `${cookieName}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.${domain};`;\n  });\n  window.localStorage.removeItem(\"access_token\");\n};\n","import { EMPTY_HEADERS } from \"@shared/types/fetch\";\n\nexport function normalizeHeaders(headers?: HeadersInit): Headers {\n  if (headers instanceof Headers) return headers;\n  return new Headers(headers || EMPTY_HEADERS);\n}\n\nexport function serializeBody(body: unknown, headers: Headers): BodyInit | undefined {\n  if (body === undefined || body === null) return undefined;\n\n  const isFormData = typeof FormData !== \"undefined\" && body instanceof FormData;\n  const isBlob = typeof Blob !== \"undefined\" && body instanceof Blob;\n  const isArrayBuffer = typeof ArrayBuffer !== \"undefined\" && body instanceof ArrayBuffer;\n\n  if (isFormData || isBlob || isArrayBuffer || typeof body === \"string\") return body as BodyInit;\n  if (!headers.has(\"Content-Type\")) headers.set(\"Content-Type\", \"application/json\");\n  return JSON.stringify(body);\n}\n\nexport function cleanParams(params: Record<string, unknown>): Record<string, string | number | boolean> {\n  return Object.fromEntries(\n    Object.entries(params).filter(([, value]) => value !== null && value !== undefined)\n  ) as Record<string, string | number | boolean>;\n}\n","export function combineURLs(baseURL: string, relativeURL: string): string {\n  if (!baseURL) return relativeURL;\n  if (!relativeURL) return baseURL;\n  const combined = baseURL.replace(/\\/+$/, \"\") + \"/\" + relativeURL.replace(/^\\/+/, \"\");\n  return combined.replace(/([^:]\\/)\\/+/g, \"$1\");\n}\n","import { isClientSide, language } from \"@shared/constants/environment.constant\";\nimport { EMPTY_HEADERS, FetchConfig, FetchHttpError, FetchMapConfig, FetchResponse } from \"@shared/types/fetch\";\nimport { clearInvalidSessionCookies } from \"@shared/utils/auth/clearInvalidSessionCookies.util\";\nimport { getCookieClientSide } from \"@shared/utils/auth/getCookie.util\";\nimport { getToken } from \"@shared/utils/auth/getToken.util\";\nimport { cleanParams, normalizeHeaders, serializeBody } from \"@shared/utils/fetch/sanitize.util\";\nimport { combineURLs } from \"@shared/utils/url/combineUrls.util\";\nimport { stringify } from \"qs\";\n\nexport class FetchClient {\n  private baseUrl: string;\n  private language?: string;\n\n  constructor(baseUrl: string) {\n    this.baseUrl = baseUrl;\n    this.language = language;\n  }\n\n  private useQueryParams(url: string, params?: Record<string, unknown>): string {\n    if (!params || Object.keys(params).length === 0) return url;\n    const cleanedParams = cleanParams(params);\n    if (Object.keys(cleanedParams).length === 0) return url;\n    const query = stringify(cleanedParams, { encodeValuesOnly: true });\n    return `${url}?${query}`;\n  }\n\n  private useLanguage(headers: Headers) {\n    if (headers.has(\"Accept-Language\")) return;\n    headers.set(\"Accept-Language\", this.language ?? \"\");\n  }\n\n  private async useBearerToken(config: FetchConfig, headers: Headers) {\n    if (!config.withAuth || headers.has(\"Authorization\")) return;\n\n    const token = isClientSide ? getCookieClientSide(\"access_token\") : await getToken();\n    if (!token) return;\n    headers.set(\"Authorization\", `Bearer ${token}`);\n  }\n\n  private usePathParams(url: string, params?: Record<string, unknown>): string {\n    if (!url || !params) return url;\n\n    const iterator = url.matchAll(/\\{(.*?)}/g);\n    for (const [keyword, path] of iterator) {\n      const value = params[path];\n      if (value === null || value === undefined) continue;\n      url = url.replace(keyword, String(value));\n      delete params[path];\n    }\n    return url;\n  }\n\n  private async applyMiddlewares(config: FetchConfig): Promise<FetchConfig> {\n    const paramsCopy = config.params ? { ...config.params } : undefined;\n    const urlWithPaths = this.usePathParams(config.url, paramsCopy);\n    const url = this.useQueryParams(urlWithPaths, paramsCopy);\n\n    const headers = new Headers(config.headers || EMPTY_HEADERS);\n    this.useLanguage(headers);\n    await this.useBearerToken(config, headers);\n\n    return { ...config, url, headers };\n  }\n\n  private composeSignal(config: FetchConfig) {\n    const controller = new AbortController();\n    const abort = (reason?: unknown) => {\n      if (controller.signal.aborted) return;\n      controller.abort(reason);\n    };\n\n    [config.signal, config.cancelToken?.signal].forEach((source) => {\n      if (!source) return;\n      if (source.aborted) return abort(source.reason);\n      source.addEventListener(\"abort\", () => abort(source.reason), { once: true });\n    });\n\n    const timeoutId = config.timeout\n      ? setTimeout(() => abort(new Error(`Request timed out after ${config.timeout}ms`)), config.timeout)\n      : undefined;\n\n    return {\n      signal: controller.signal,\n      cleanup: () => {\n        if (!timeoutId) return;\n        clearTimeout(timeoutId);\n      }\n    };\n  }\n\n  async request<T>(config: FetchConfig): Promise<FetchResponse<T>> {\n    const { signal, cleanup } = this.composeSignal(config);\n\n    const normalizedHeaders = normalizeHeaders(config.headers);\n    const body = serializeBody(config.body, normalizedHeaders);\n    const finalConfig = await this.applyMiddlewares({ ...config, signal, headers: normalizedHeaders, body });\n    try