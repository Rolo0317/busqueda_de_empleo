# Bot de Búsqueda de Empleo - Ejemplo de Configuración
# COPIAR ESTE ARCHIVO A .env Y RELLENAR CON TUS VALORES

# ============================================================================
# CONFIGURACIÓN DE NAVEGADOR
# ============================================================================
# Navegador a usar: 'edge' o 'chrome'
BROWSER=edge

# Ruta del perfil de usuario Edge (donde está tu sesión de Google/Magneto)
EDGE_USER_DATA_DIR=C:\Users\{tu_usuario}\AppData\Local\Microsoft\Edge\User Data
EDGE_PROFILE_DIRECTORY=Default
EDGE_BINARY_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Ruta del perfil de Chrome (opcional)
CHROME_USER_DATA_DIR=C:\Users\{tu_usuario}\AppData\Local\Google\Chrome\User Data
CHROME_PROFILE_DIRECTORY=Default

# Permitir perfil bot fallback si el perfil real no está disponible
ALLOW_BOT_PROFILE_FALLBACK=false

# ============================================================================
# BÚSQUEDA DE EMPLEO
# ============================================================================
# Palabras clave para búsqueda (separadas por comas)
# OPTIMIZADO PARA MÁS POSTULACIONES
MAGNETO_SEARCH_KEYWORDS=Developer,JavaScript,Python,Backend,Frontend,Node.js,React,Full Stack,Junior,Senior,Analyst,Engineer,Programmer

# Ciudad/ubicación en Magneto365
MAGNETO_CITY=Bogota

# Ubicaciones objetivo (separadas por comas)
TARGET_LOCATIONS=Colombia,Bogota,Medellin,Remoto LATAM,Remoto Worldwide,Remoto,Cali,Barranquilla

# Máximo de ofertas por búsqueda (AUMENTADO para más postulaciones)
MAX_OFFERS=100

# Esperar X segundos entre aplicaciones (REDUCIDO para más velocidad)
WAIT_SECONDS=5

# Ejecutar continuamente (true) o solo una vez (false)
RUN_CONTINUOUSLY=true

# Intervalo entre ciclos de búsqueda en segundos (REDUCIDO para más ciclos)
LOOP_INTERVAL_SECONDS=180

# ============================================================================
# FILTROS Y ANÁLISIS
# ============================================================================
# Salario mínimo aceptado (COP)
MIN_SALARY=2500000

# Skills de alta prioridad (separadas por comas)
# AMPLIADO para aceptar más ofertas
PRIORITY_SKILLS=Developer,JavaScript,Python,Backend,Frontend,Node.js,React,TypeScript,Junior,Senior,Analyst,Engineer,SQL,APIs

# Puntuación mínima para aplicar (0-100) - REDUCIDA para más postulaciones
MIN_MATCH_SCORE=50

# Ruta al CV/Resume
CV_PATH=./cv.pdf

# Ruta al perfil de candidato JSON
CANDIDATE_PROFILE_PATH=./candidate_profile.json

# Esperar X segundos para que se cargue la página de login
LOGIN_WAIT_SECONDS=180

# ============================================================================
# BASE DE DATOS MYSQL
# ============================================================================
# Host del servidor MySQL
DB_HOST=localhost

# Puerto de MySQL
DB_PORT=3306

# Usuario de MySQL
DB_USER=root

# Contraseña de MySQL (NO dejar en blanco en producción)
DB_PASSWORD=tu_contraseña_segura_aqui

# Nombre de la base de datos
DB_NAME=job_bot
