# ============================================================
# Plantilla de configuracion. Copiala como .env y rellena los valores.
# NUNCA pongas aqui claves reales: este archivo si se sube a git.
# ============================================================

# --- Base de datos MySQL (la usan el bot y el panel) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_bot

# --- Navegador: el bot se engancha al Edge abierto por abrir_navegador_bot.ps1 ---
EDGE_DEBUGGER_ADDRESS=127.0.0.1:9222

# --- Busqueda y postulacion ---
PLATFORMS=magneto,computrabajo
MAGNETO_SEARCH_KEYWORDS=python,sql,power bi,full stack,data analyst
MAGNETO_CITY=Bogota
TARGET_LOCATIONS=Colombia,Bogota,Remoto LATAM,Remoto Worldwide
PRIORITY_SKILLS=Python,SQL,Power BI,JavaScript,HTML,CSS,APIs,Docker,IA
MIN_MATCH_SCORE=45
MIN_SALARY=2500000
# Tope de postulaciones enviadas por corrida; 0 es sin tope.
MAX_OFFERS=0
WAIT_SECONDS=3
LOOP_INTERVAL_SECONDS=300
RUN_CONTINUOUSLY=true
SUPERVISED_APPLY=true
EXHAUSTIVE_MODE=false

# --- Perfil y hoja de vida ---
# cv_builder puede generar el PDF desde el perfil (dist/); tambien sirve uno propio.
# El que se adjunta al postular es la version ATS: la de diseño la leen mal los filtros.
# Ruta completa al PDF de tu hoja de vida (mejor una version de una columna, apta para ATS).
CV_PATH=C:\Users\<usuario>\Documents\mi_hoja_de_vida.pdf
CANDIDATE_PROFILE_PATH=job_bot\candidate_profile.json

# --- IA para preguntas abiertas (opcional; sin clave se usan respuestas locales) ---
ATS_AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Panel (Django) ---
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
BOT_MAX_OFFERS=20
